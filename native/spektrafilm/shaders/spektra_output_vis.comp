#version 450

// TEMPORARY debug visualizer (not part of the spike): maps arbitrary float
// buffers (linear, log, density domains) into visible range.
layout(local_size_x = 32, local_size_y = 8, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer SourcePixels {
  vec4 src[];
};

layout(set = 0, binding = 1, rgba8) uniform writeonly image2D dstImage;

layout(push_constant) uniform OutParams {
  uint width;
  uint height;
} params;

void main() {
  const uvec2 gid = gl_GlobalInvocationID.xy;
  if (gid.x >= params.width || gid.y >= params.height) {
    return;
  }
  const uint index = gid.y * params.width + gid.x;
  const vec4 pixel = src[index];
  // Map [-5,5] -> [0,1]: shows log-domain (~-4..0), density (~0..3),
  // and linear (~0..1) with visible variation if any exists. Alpha is
  // mapped too (1.0 -> 153) to distinguish "stage ran" from "never wrote".
  imageStore(dstImage, ivec2(gid), vec4(clamp((pixel.rgb + 5.0) / 10.0, vec3(0.0), vec3(1.0)), clamp((pixel.a + 5.0) / 10.0, 0.0, 1.0)));
}
