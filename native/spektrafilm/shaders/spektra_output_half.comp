#version 450

// Float film output (PrintScan destination / scanner finalize buffer) ->
// RGBA16F storage image. No clamp: PQ/HLG signals are nominally 0..1 but
// RCM timeline linear keeps headroom (>1) and signed values. Alpha passes
// through. Optional TPDF dither (push flag, SPEKTRA_FILM_OUTPUT_DITHER=1)
// decorrelates half quantization like SpektraFormatConvert.
layout(local_size_x = 32, local_size_y = 8, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer SourcePixels {
  vec4 src[];
};

layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D dstImage;

layout(push_constant) uniform OutParams {
  uint width;
  uint height;
  uint dither;
  uint _pad;
  vec4 sensorRow0;
  vec4 sensorRow1;
  vec4 sensorRow2;
} params;

uint hashUint(uint value) {
  value ^= value >> 16u;
  value *= 0x7feb352du;
  value ^= value >> 15u;
  value *= 0x846ca68bu;
  value ^= value >> 16u;
  return value;
}

float hashUnitFloat(uint value) {
  return float(hashUint(value) & 0x00ffffffu) * (1.0 / 16777216.0);
}

float halfUlp(float value) {
  const float magnitude = abs(value);
  if (isnan(magnitude) || isinf(magnitude) || magnitude >= 65504.0) {
    return 0.0;
  }
  if (magnitude < 6.103515625e-5) {
    return 5.960464477539063e-8;
  }
  return exp2(floor(log2(magnitude)) - 10.0);
}

void main() {
  const uvec2 gid = gl_GlobalInvocationID.xy;
  if (gid.x >= params.width || gid.y >= params.height) {
    return;
  }
  const uint index = gid.y * params.width + gid.x;
  vec4 pixel = src[index];
  if (params.dither != 0u) {
    const uint seed = index * 747796405u + 0x9e3779b9u;
    const float tpdf =
        0.5 * (hashUnitFloat(seed) + hashUnitFloat(seed ^ 0x85ebca6bu) - 1.0);
    pixel.rgb += tpdf * vec3(halfUlp(pixel.r), halfUlp(pixel.g), halfUlp(pixel.b));
  }
  imageStore(dstImage, ivec2(gid), pixel);
}
