#version 450

// RGBA16F input image -> float32 pixel buffer. Storage-image load already
// returns unpacked floats, so this is a plain copy into the SSBO layout the
// (unmodified) exposure shader expects.
layout(local_size_x = 32, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 1, rgba16f) uniform readonly image2D srcImage;

layout(std430, binding = 0) writeonly buffer DestinationPixels {
  vec4 dst[];
};

layout(push_constant) uniform InParams {
  uint width;
  uint height;
  // Row-major sensor->linear-sRGB; .w padding (push layout: 16B rows).
  vec4 sensorRow0;
  vec4 sensorRow1;
  vec4 sensorRow2;
} params;

void main() {
  const uvec2 gid = gl_GlobalInvocationID.xy;
  if (gid.x >= params.width || gid.y >= params.height) {
    return;
  }
  const vec4 p = imageLoad(srcImage, ivec2(gid));
  const vec3 srgb = vec3(
    dot(params.sensorRow0.xyz, p.rgb),
    dot(params.sensorRow1.xyz, p.rgb),
    dot(params.sensorRow2.xyz, p.rgb));
  dst[gid.y * params.width + gid.x] = vec4(srgb, p.a);
}
