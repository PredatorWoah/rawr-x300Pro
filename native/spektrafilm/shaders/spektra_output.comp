#version 450

// Float HDR film output (PrintScan destination buffer) -> SDR RGBA8 storage
// image. PrintScan already applied output transfer encoding, so this is a
// plain clamp + pack. Alpha passes through (PrintScan preserves source alpha).
layout(local_size_x = 32, local_size_y = 8, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer SourcePixels {
  vec4 src[];
};

layout(set = 0, binding = 1, rgba8) uniform writeonly image2D dstImage;

layout(push_constant) uniform OutParams {
  uint width;
  uint height;
  uint dither;
  uint _pad;
} params;

uint hashUint(uint value) {
  value ^= value >> 16u;
  value *= 0x7feb352du;
  value ^= value >> 15u;
  value *= 0x846ca68bu;
  value ^= value >> 16u;
  return value;
}

float hashUnitFloat(uint value) {
  return float(hashUint(value) & 0x00ffffffu) * (1.0 / 16777216.0);
}

void main() {
  const uvec2 gid = gl_GlobalInvocationID.xy;
  if (gid.x >= params.width || gid.y >= params.height) {
    return;
  }
  const uint index = gid.y * params.width + gid.x;
  vec4 pixel = src[index];
  if (params.dither != 0u) {
    // TPDF +/-0.5 LSB8: breaks gradient banding, averages to the undithered
    // value. Off by default (parity); enable with SPEKTRA_FILM_OUTPUT_DITHER=1.
    const uint seed = index * 747796405u + 0x9e3779b9u;
    const float tpdf =
        0.5 * (hashUnitFloat(seed) + hashUnitFloat(seed ^ 0x85ebca6bu) - 1.0);
    pixel.rgb += tpdf * vec3(1.0 / 255.0);
  }
  imageStore(dstImage, ivec2(gid), vec4(clamp(pixel.rgb, vec3(0.0), vec3(1.0)), pixel.a));
}
