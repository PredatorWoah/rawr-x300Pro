#version 450
layout(local_size_x = 16, local_size_y = 16) in;
layout(binding = 0, rgba16f) uniform readonly image2D srcImage;
layout(binding = 1, r16ui) uniform writeonly uimage2D clipStateImage;
layout(push_constant) uniform Pc {
    uint width;
    uint height;
    float threshold;
    uint pad;
}
pc;

bool finiteValue(float x) { return !isnan(x) && !isinf(x); }

void main() {
    ivec2 cell = ivec2(gl_GlobalInvocationID.xy);
    ivec2 stateExtent = ivec2(int(pc.width >> 1), int(pc.height >> 1));
    if (any(greaterThanEqual(cell, stateExtent))) return;

    ivec2 base = cell << 1;
    uint state = 0u;
    for (int y = 0; y < 2; ++y) {
        for (int x = 0; x < 2; ++x) {
            vec3 rgb = imageLoad(srcImage, min(base + ivec2(x, y), ivec2(int(pc.width) - 1, int(pc.height) - 1))).rgb;
            if (!finiteValue(rgb.r) || rgb.r >= pc.threshold) state |= 1u;
            if (!finiteValue(rgb.g) || rgb.g >= pc.threshold) state |= 2u | 4u;
            if (!finiteValue(rgb.b) || rgb.b >= pc.threshold) state |= 8u;
        }
    }
    imageStore(clipStateImage, cell, uvec4(state, 0u, 0u, 0u));
}
