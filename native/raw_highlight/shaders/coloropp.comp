#version 450
#ifndef RAWR_COLOROPP_POST_WB
#define RAWR_COLOROPP_POST_WB 0
#endif
// RAWR_COLOROPP_FUSED_WB=1 (still/video) also applies the white balance and the
// Inpaint Opposed highlight passthrough, writing the post-WB image that
// still_apply_wb.comp + highlight_recover.comp (enabled 2) would produce from
// the pre-WB result. It replaces those two full-resolution passes.
#ifndef RAWR_COLOROPP_FUSED_WB
#define RAWR_COLOROPP_FUSED_WB 0
#endif
#extension GL_GOOGLE_include_directive : require
// RawTherapee 5.13 Coloropp (Inpaint Opposed), evaluated on pre-WB demosaiced
// camera RGB. The source's global chroma offset is identically zero: each
// unclipped channel's temporary value is its original value in the sampled
// residual.
//
// RAWR_COLOROPP_POST_WB=1 builds the same operator for input that is already
// white balanced (preview): the clip test scales by wb per channel and the
// opposed-channel mean is taken directly, which is algebraically identical to
// the pre-WB form.
layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 0, rgba16f) uniform readonly image2D sourceRgb;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D targetRgb;
layout(push_constant) uniform Params {
    uint width, height, gridWidth, gridHeight;
    uint cfaPattern;
    float clipval;
    uint gridEnabled, pad;
    vec4 wb;
    uint sensorWidth, sensorHeight, cropX, cropY, sensorScale;
#if RAWR_COLOROPP_FUSED_WB
    vec4 gains;  // exact WB multipliers of the replaced WB pass
#endif
} p;

#define LSC_BINDING 2
#define LSC_ENABLED (p.gridEnabled != 0u)
#define LSC_GRID_SIZE uvec2(p.gridWidth, p.gridHeight)
#define LSC_SENSOR_SIZE uvec2(p.sensorWidth, p.sensorHeight)
#include "lens_shading.glsl"
#include "cfa_common.glsl"
#if RAWR_COLOROPP_FUSED_WB
#include "raw_highlight_post_rgb.glsl"

// Round to the nearest half float, ties to even, as the RGBA16F store of the
// pre-WB image did before the WB pass read it back. Done in integer math so
// it does not depend on the driver's packHalf2x16 rounding.
float roundHalf(float f) {
    uint x = floatBitsToUint(f), sign = x & 0x80000000u, a = x & 0x7fffffffu;
    if (a >= 0x7f800000u) return f;
    if (a >= 0x477ff000u) return uintBitsToFloat(sign | 0x7f800000u);
    if (a < 0x38800000u) {
        float q = roundEven(uintBitsToFloat(a) * 16777216.0) / 16777216.0;
        return uintBitsToFloat(sign | floatBitsToUint(q));
    }
    a += 0x0fffu + ((a >> 13) & 1u);
    return uintBitsToFloat(sign | (a & ~0x1fffu));
}
// The WB result was stored as RGBA16F before the highlight passthrough read
// it: the sanitize clamp commutes with rounding except for overflow to inf.
void storeWhiteBalanced(ivec2 xy, vec3 preWb, float alpha) {
    const float inf = uintBitsToFloat(0x7f800000u);
    vec3 wb = preWb * p.gains.rgb;
    wb = mix(wb, sign(wb) * inf, greaterThanEqual(abs(wb), vec3(65520.0)));
    imageStore(targetRgb, xy, vec4(rawrHighlightSanitize(wb), alpha));
}
#endif

float shadingAt(ivec2 xy) {
    ivec2 sensorXY = ivec2(p.cropX, p.cropY) + xy * int(p.sensorScale);
    int c = rawrCfaChannelAt(p.cfaPattern, sensorXY);
    return lensShadingGain(sensorXY, c == 2 ? 1 : c);
}
void main() {
    ivec2 xy = ivec2(gl_GlobalInvocationID.xy);
    if (xy.x >= int(p.width) || xy.y >= int(p.height)) return;
    vec4 original = imageLoad(sourceRgb, xy);
#if RAWR_COLOROPP_POST_WB
    bvec3 hit = greaterThanEqual(original.rgb, p.clipval * shadingAt(xy) * p.wb.rgb);
#else
    bvec3 hit = greaterThanEqual(original.rgb, vec3(p.clipval * shadingAt(xy)));
#endif
    if (xy.x == 0 || xy.y == 0 || xy.x == int(p.width)-1 || xy.y == int(p.height)-1 || !any(hit)) {
#if RAWR_COLOROPP_FUSED_WB
        storeWhiteBalanced(xy, original.rgb, original.a);
#else
        imageStore(targetRgb, xy, original);
#endif
        return;
    }
    vec3 total = vec3(0.0);
    for (int dy = -1; dy <= 1; ++dy)
        for (int dx = -1; dx <= 1; ++dx)
#if RAWR_COLOROPP_POST_WB
            total += max(imageLoad(sourceRgb, xy + ivec2(dx,dy)).rgb, vec3(0.0));
#else
            total += max(imageLoad(sourceRgb, xy + ivec2(dx,dy)).rgb * p.wb.rgb, vec3(0.0));
#endif
    vec3 root = pow(total / 9.0, vec3(1.0 / 3.0));
    vec3 opposed = vec3((root.g + root.b) * 0.5, (root.r + root.b) * 0.5,
                        (root.r + root.g) * 0.5);
    vec3 reference = opposed * opposed * opposed;
    vec3 value = original.rgb;
    for (int c = 0; c < 3; ++c)
#if RAWR_COLOROPP_POST_WB
        if (hit[c]) value[c] = max(max(original[c], 0.0), reference[c]);
#else
        if (hit[c]) value[c] = max(max(original[c], 0.0) * p.wb[c], reference[c]) / p.wb[c];
#endif
#if RAWR_COLOROPP_FUSED_WB
    storeWhiteBalanced(xy, vec3(roundHalf(value.r), roundHalf(value.g), roundHalf(value.b)), original.a);
#else
    imageStore(targetRgb, xy, vec4(value, original.a));
#endif
}
