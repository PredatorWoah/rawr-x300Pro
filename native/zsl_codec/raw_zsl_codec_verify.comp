#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(set = 0, binding = 0, r16ui) uniform readonly uimage2D srcRaw;
layout(set = 0, binding = 1, std430) readonly buffer MetaBuf { uint meta[]; }
META;
layout(set = 0, binding = 2, std430) readonly buffer SizeBuf { uint sizes[]; }
SIZES;
layout(set = 0, binding = 3, std430) readonly buffer PayloadBuf { uint payload[]; }
PAY;
layout(set = 0, binding = 4, std430) buffer VerifyBuf {
    uint mismatchCount;
    uint firstX;
    uint firstY;
    uint maxAbs;
}
VERIFY;
layout(set = 0, binding = 5, std430) readonly buffer OffsetBuf { uint offsets[]; }
OFFSETS;
layout(set = 0, binding = 6, std430) readonly buffer AllocBuf { uint nextWord; }
ALLOC;
layout(push_constant) uniform PC { uint width, height, tilesX, tilesY, slotWords; }
pc;
uint extractResidual(uint base, uint bits, uint si) {
    if (bits == 0u) return 0u;
    uint bit = si * bits, wi = bit >> 5u, off = bit & 31u;
    uint lo = PAY.payload[base + wi] >> off;
    uint v = lo;
    if (off + bits > 32u) v |= PAY.payload[base + wi + 1u] << (32u - off);
    uint mask = (bits == 32u) ? 0xffffffffu : ((1u << bits) - 1u);
    return v & mask;
}
void main() {
    uint x = gl_GlobalInvocationID.x, y = gl_GlobalInvocationID.y;
    if (x >= pc.width || y >= pc.height) return;
    uint tx = x >> 5u, ty = y >> 5u, tile = ty * pc.tilesX + tx, p = (y & 1u) * 2u + (x & 1u), stream = tile * 4u + p,
         m = META.meta[stream], mn = m & 0xffffu, bits = (m >> 16u) & 31u, x0 = tx * 32u, y0 = ty * 32u, px = p & 1u,
         py = p >> 1u;
    uint validW = (x0 + px < pc.width) ? ((min(x0 + 32u, pc.width) - x0 - px + 1u) >> 1u) : 0u;
    uint sx = (x - x0 - px) >> 1u, sy = (y - y0 - py) >> 1u, si = sy * validW + sx,
         decoded = mn + extractResidual(OFFSETS.offsets[stream], bits, si), src = imageLoad(srcRaw, ivec2(x, y)).r;
    if (decoded != src) {
        uint old = atomicAdd(VERIFY.mismatchCount, 1u);
        if (old == 0u) {
            VERIFY.firstX = x;
            VERIFY.firstY = y;
        }
        uint d = (decoded > src) ? decoded - src : src - decoded;
        atomicMax(VERIFY.maxAbs, d);
    }
}
