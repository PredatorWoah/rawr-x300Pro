#version 450
// Pass 3: demodulate resid (= in - guide) with the 9 distinct lattice
// carriers and 8x8 block-mean downsample into the coarse array.
// One invocation per coarse texel; 4 CFA phases packed into RGBA.
//
// Plane coords: phase (py,px) plane pel (i,j) == full-res (2j+px, 2i+py).
// Coarse texel (cx,cy) covers plane block 8x8. The 8x8 block mean exactly
// nulls the demod double-frequency terms (2f*8 is an even integer for all
// q/8 carriers), so no prefilter is needed before downsampling.
layout(local_size_x = QUADFIX_LOCAL_X, local_size_y = QUADFIX_LOCAL_Y, local_size_z = 1) in;
#include "quadfix_common.glsl"

// 9 distinct (qy,qx); entries 6..8 are real-only Nyquist carriers.
const int DEM_QY[9] = int[9](0, 1, 1, 1, 1, 2, 0, 2, 2);
const int DEM_QX[9] = int[9](1, 0, 1, 3, 2, 1, 2, 0, 2);

void main() {
    ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    int cw = (int(pc.width) >> 4);   // W/16 coarse texels
    int ch = (int(pc.height) >> 4);  // H/16
    if (c.x >= cw || c.y >= ch) return;
    // accumulators [carrier][phase]: 6 complex pairs (re,im) + 3 Nyquist (re).
    // Estimates MUST stay per-phase: a unified full-res demod cannot
    // represent per-phase lattice offsets (measured: unified leaves 100% of
    // the lattice energy, per-phase leaves 0.1%).
    float re[9][4];
    float im[6][4];
    for (int k = 0; k < 9; ++k)
        for (int ph = 0; ph < 4; ++ph) re[k][ph] = 0.0f;
    for (int k = 0; k < 6; ++k)
        for (int ph = 0; ph < 4; ++ph) im[k][ph] = 0.0f;
    for (int py = 0; py < 2; ++py)
        for (int px = 0; px < 2; ++px) {
            int ph = py * 2 + px;
            for (int by = 0; by < 8; ++by)
                for (int bx = 0; bx < 8; ++bx) {
                    int pi = c.y * 8 + by;
                    int pj = c.x * 8 + bx;
                    ivec2 p = ivec2(2 * pj + px, 2 * pi + py);
                    float z = bayerAt(p) - imageLoad(guideImg, p).r;
                    for (int k = 0; k < 9; ++k) {
                        float carrier = carrierPhase(DEM_QY[k], DEM_QX[k], pi, pj);
                        float co = cos(carrier);
                        re[k][ph] += z * co;
                        if (k < 6) im[k][ph] += z * sin(carrier);
                    }
                }
        }
    const float inv = 1.0f / 64.0f;
    // Layer k holds channel k; RGBA holds the 4 phases (xyz2 = py*2+px).
    for (int k = 0; k < 6; ++k) {
        imageStore(coarseArr, ivec3(c, 2 * k),
                   vec4(re[k][0], re[k][1], re[k][2], re[k][3]) * inv);
        imageStore(coarseArr, ivec3(c, 2 * k + 1),
                   vec4(im[k][0], im[k][1], im[k][2], im[k][3]) * inv);
    }
    imageStore(coarseArr, ivec3(c, 12), vec4(re[6][0], re[6][1], re[6][2], re[6][3]) * inv);
    imageStore(coarseArr, ivec3(c, 13), vec4(re[7][0], re[7][1], re[7][2], re[7][3]) * inv);
    imageStore(coarseArr, ivec3(c, 14), vec4(re[8][0], re[8][1], re[8][2], re[8][3]) * inv);
}
