#version 450
// Pass 2: residual energy e = sqrt(9x9 mean(resid^2)) per same-color plane
// (buffer + guideImg -> energyImg). Resid itself is recomputed on demand
// by later passes; only e is stored.
layout(local_size_x = QUADFIX_LOCAL_X, local_size_y = QUADFIX_LOCAL_Y, local_size_z = 1) in;
#include "quadfix_common.glsl"

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= int(pc.width) || p.y >= int(pc.height)) return;
    float g0 = imageLoad(guideImg, p).r;
    float s = 0.0f;
    for (int dy = -4; dy <= 4; ++dy)
        for (int dx = -4; dx <= 4; ++dx) {
            float r = bayerPhaseAt(p, dx, dy) - guidePhaseAt(p, dx, dy);
            s += r * r;
        }
    imageStore(energyImg, p, vec4(sqrt(s * (1.0f / 81.0f))));
}
