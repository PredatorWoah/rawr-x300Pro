#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(binding = 0, rgba16f) uniform readonly image2D rcdRgb;
layout(binding = 2, r32f) uniform writeonly image2D luminanceOut;
layout(push_constant) uniform Push {
    uint width;
    uint height;
    float threshold;
    float outputFactor;
    float outputAlpha;
    float b1;
    float b2;
    float b3;
    float B;
    float m00;
    float m01;
    float m02;
    float m10;
    float m11;
    float m12;
    float m20;
    float m21;
    float m22;
}
pc;
const float KAPPA = 24389.0 / 27.0;
const float EPSILON = 216.0 / 24389.0;
float labLFromNormalizedY(float y) {
    if (y <= EPSILON) return 327.68 * KAPPA * y;
    return 327.68 * (116.0 * pow(y, 1.0 / 3.0) - 16.0);
}
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= int(pc.width) || p.y >= int(pc.height)) return;
    vec3 rgb = imageLoad(rcdRgb, p).rgb;
    float y = 0.212671 * rgb.r + 0.715160 * rgb.g + 0.072169 * rgb.b;
    imageStore(luminanceOut, p, vec4(labLFromNormalizedY(y), 0, 0, 0));
}
