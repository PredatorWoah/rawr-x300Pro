#version 450

// Support-aware cleanup of merge fallback areas, run as two separable passes
// before a11_finalize. Pixels where the merge fell back to fewer frames
// (motion, rejection, low coverage) keep the reference's single-frame noise
// next to fully merged neighbours. Each pixel's effective frame count
// F = mix(1, accepted, confidence) sets how many extra samples it needs to
// match a full merge of N frames: K = N / F - 1, gathered with a luma-guided
// Gaussian of sigma gain * sqrt(K / 4pi). "accepted" is the robustness
// support (companions the motion checks kept), not Neff: Neff is also low on
// static edges, where the detail kernel is narrow by design, and smoothing
// there would cost sharpness and colour detail. The range guard is
// noise-aware (single-frame noise from the merge's noise model), so it
// averages across noise but stops at real edges. Chroma and luma use their
// own gains; moving or rejected areas lose their single-frame grain and read
// as smooth motion.
//
// pass 0: horizontal gather from sum/weight into outI (scratch).
// pass 1: vertical gather from outI; the result replaces sum/weight
//         (rgb = result, weight = 1) so a11_finalize writes it out.
// Taps are dense: a strided 2D gather drew steps and strips along edges.
// Fully merged pixels pass through unchanged (same output as a11_finalize).
layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 0, rgba32f) uniform image2D sumI;
layout(set = 0, binding = 1, rgba32f) uniform image2D weightI;
layout(set = 0, binding = 2, rgba16f) uniform image2D outI;
// Accumulated companion robustness (same image/indexing as reference_accumulate).
layout(set = 0, binding = 3, r32f) readonly uniform image2D supportI;
layout(push_constant) uniform P {
    int yBase;
    float targetFrames;
    float gain;
    float maxSigma;
    float lumaGain;
    float noiseSlope;
    float noiseOffset;
    float scale;
    int pass;
} p;

vec3 rgbAt(ivec2 lq) {
    lq = clamp(lq, ivec2(0), imageSize(sumI) - 1);
    vec3 s = imageLoad(sumI, lq).rgb, w = imageLoad(weightI, lq).rgb;
    return vec3(w.x > 1e-12 ? s.x / w.x : 0.0, w.y > 1e-12 ? s.y / w.y : 0.0, w.z > 1e-12 ? s.z / w.z : 0.0);
}

vec3 rowAt(ivec2 lq) {
    lq = clamp(lq, ivec2(0), imageSize(sumI) - 1);
    return imageLoad(outI, ivec2(lq.x, lq.y + p.yBase)).rgb;
}

float luma(vec3 c) { return dot(c, vec3(0.25, 0.5, 0.25)); }

void main() {
    ivec2 lq = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(lq, imageSize(sumI)))) return;
    ivec2 q = ivec2(lq.x, lq.y + p.yBase);
    if (any(greaterThanEqual(q, imageSize(outI)))) return;
    vec3 center = rgbAt(lq);
    float confidence = clamp(imageLoad(sumI, lq).a, 0.0, 1.0);
    vec2 ref = (vec2(q) + .5) / p.scale - .5;
    ivec2 rq = clamp(ivec2(floor((ref + .5) * .5)), ivec2(0), imageSize(supportI) / 2 - 1);
    float acceptedFrames = 1.0 + max(imageLoad(supportI, rq).x, 0.0);
    float frames = max(mix(1.0, acceptedFrames, confidence), 1.0);
    float extra = max(p.targetFrames / frames - 1.0, 0.0);
    float sigma = min(p.gain * sqrt(extra / 12.566371), p.maxSigma);
    float lumaExtra = max(p.targetFrames / acceptedFrames - 1.0, 0.0);
    float lumaSigma = min(p.lumaGain * sqrt(lumaExtra / 12.566371), p.maxSigma);
    float gatherSigma = max(sigma, lumaSigma);
    if (!(gatherSigma > 0.35)) {
        if (p.pass == 0) imageStore(outI, q, vec4(center, 1.0));
        return;
    }
    float y0 = luma(center);
    // Single-frame luma noise at this level; a fallback pixel carries about
    // that much. Guard at 2.5 sigma: noise steps are averaged, edges are not.
    float noiseSigma = sqrt(max(p.noiseSlope * max(y0, 0.0) + p.noiseOffset, 1e-12));
    float rangeScale = 2.5 * noiseSigma + 0.02 * max(y0, 0.0);
    int radius = int(ceil(2.0 * gatherSigma));
    ivec2 axis = p.pass == 0 ? ivec2(1, 0) : ivec2(0, 1);
    vec3 chromaSum = vec3(0.0);
    float chromaWeight = 0.0, lumaSum = 0.0, lumaWeight = 0.0;
    for (int d = -radius; d <= radius; ++d) {
        vec3 c = p.pass == 0 ? rgbAt(lq + d * axis) : rowAt(lq + d * axis);
        float y = luma(c);
        float d2 = float(d * d);
        float t = (y - y0) / rangeScale;
        float range = exp(-0.5 * t * t);
        if (sigma > 0.35) {
            float w = exp(-d2 / (2.0 * sigma * sigma)) * range;
            chromaSum += w * (c - vec3(y));
            chromaWeight += w;
        }
        if (lumaSigma > 0.35) {
            float w = exp(-d2 / (2.0 * lumaSigma * lumaSigma)) * range;
            lumaSum += w * y;
            lumaWeight += w;
        }
    }
    vec3 base = p.pass == 0 ? center : rowAt(lq);
    float yBase = luma(base);
    vec3 chroma = chromaWeight > 0.0 ? chromaSum / chromaWeight : base - vec3(yBase);
    float yOut = lumaWeight > 0.0 ? lumaSum / lumaWeight : yBase;
    vec3 result = vec3(yOut) + chroma;
    if (p.pass == 0) {
        imageStore(outI, q, vec4(result, 1.0));
    } else {
        imageStore(sumI, lq, vec4(result, imageLoad(sumI, lq).a));
        imageStore(weightI, lq, vec4(1.0, 1.0, 1.0, imageLoad(weightI, lq).a));
    }
}
