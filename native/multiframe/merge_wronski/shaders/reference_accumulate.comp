    rawrTrace4(111u, o, 0u, vec4(qi, 0.0));
    ivec2 center = ivec2(roundEven(ref));
    for (int y = -radius; y <= radius; ++y)
        for (int x = -radius; x <= radius; ++x) {
            ivec2 q = center + ivec2(x, y);
            if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, imageSize(rawI)))) continue;
            vec2 d = vec2(q) - ref;
            precise float qx = qi.x * d.x;
            precise float qxy2 = qi.y + qi.y;
            precise float qy = qxy2 * d.x;
            qy = qy * d.y;
            precise float q4 = fma(qx, d.x, qy);
            precise float qyy = qi.z * d.y;
            q4 = fma(qyy, d.y, q4);
            precise float z = max(0.0, q4 / power);
            precise float ww = rawrExpF32(-.5 * z);
            int cc = ch(q);
            float rv = imageLoad(rawI, q).x;
            uint tap = uint((y + radius) * (2 * radius + 1) + (x + radius));
            rawrTrace4(120u, o, tap, vec4(d, z, ww));
            rawrTrace4(121u, o, tap, vec4(float(cc), rv, rv * ww, 0.0));
            precise float rsv = rv * ww;  // trace-only product
            // V3U proved CPU reference weighted sum follows FMA; weight add was ambiguous/equal.
            rs[cc] = fma(rv, ww, rs[cc]);
            rw[cc] = rw[cc] + ww;
            rawrTrace4(122u, o, tap, rs);
            rawrTrace4(123u, o, tap, rw);
        }
    rawrTrace4(130u, o, 0u, rs);
    rawrTrace4(131u, o, 0u, rw);
    vec4 s = imageLoad(sumI, localO), w = imageLoad(weightI, localO);
    {
        vec3 total = w.rgb + rw.rgb;
        vec3 square = vec3(s.a, w.a, imageLoad(squareBI, localO).x) + rw.rgb * rw.rgb;
        vec3 effectiveFrames = total * total / max(square, vec3(1e-20));
        // Total robustness alone is not color support: measure Gaussian mass
        // at this actual output position. Repeated poor phases retain low mass
        // even as the nominal/effective frame count increases.
        vec3 mass = total / max(localAcc + 1.0, 1.0);
        // Coverage gates are push-constant driven (defaults 1..3 Neff,
        // .001..03 mass preserve legacy behavior). Repeated poor phases
        // retain low mass even as nominal frame count grows, so they
        // correctly fall back to the bounded reference instead of smearing.
        vec3 certainty = smoothstep(vec3(p.neffLo), vec3(p.neffHi), effectiveFrames) *
                         smoothstep(vec3(p.massLo), vec3(p.massHi), mass);
        float confidence = min(certainty.r, min(certainty.g, certainty.b));
        vec3 merged = (s.rgb + rs.rgb) / max(total, vec3(1e-20));
        vec3 base = referenceRgb(ref);
        vec3 rgb = mix(base, merged, confidence);
        // Normalize here so finalization never interprets a missing color as
        // black. Alpha lanes retain diagnostics (confidence and min Neff).
        imageStore(sumI, localO, vec4(rgb, confidence));
        imageStore(weightI, localO, vec4(1, 1, 1, min(effectiveFrames.r, min(effectiveFrames.g, effectiveFrames.b))));
        return;
    }
}
