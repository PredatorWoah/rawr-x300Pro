#version 450

// RAWR parity scalar trace ABI. Normal production shaders compile this out.
#ifdef RAWR_PARITY_TRACE
layout(std430, set = 0, binding = 31) buffer RawrTraceBuffer {
    uint writeCount;
    uint droppedCount;
    uint _tracePad0;
    uint _tracePad1;
    uvec4 cfg0;
    ivec4 cfg1;
    uvec4 meta[];
}
rawrTrace;
const uint RAWR_TRACE_STAGE = 11u;
bool rawrTraceMatch(ivec2 q) {
    if (rawrTrace.cfg0.x == 0u) return false;
    if (rawrTrace.cfg0.y != 0u && rawrTrace.cfg0.y != RAWR_TRACE_STAGE) return false;
    int tx = int(rawrTrace.cfg0.z), ty = int(rawrTrace.cfg0.w);
    return (tx < 0 || q.x == tx) && (ty < 0 || q.y == ty);
}
void rawrTrace4(uint checkpoint, ivec2 q, uint aux, vec4 v) {
    if (!rawrTraceMatch(q)) return;
    uint i = atomicAdd(rawrTrace.writeCount, 1u);
    uint cap = uint(max(rawrTrace.cfg1.x, 0));
    if (i >= cap) {
        atomicAdd(rawrTrace.droppedCount, 1u);
        return;
    }
    uint b = i * 2u;
    rawrTrace.meta[b] = uvec4(RAWR_TRACE_STAGE, checkpoint, uint(q.x), uint(q.y));
    rawrTrace.meta[b + 1u] = uvec4(aux, floatBitsToUint(v.x), floatBitsToUint(v.y), floatBitsToUint(v.z));
}
#else
void rawrTrace4(uint checkpoint, ivec2 q, uint aux, vec4 v) {}
#endif
void rawrTrace1(uint checkpoint, ivec2 q, uint aux, float x) { rawrTrace4(checkpoint, q, aux, vec4(x, 0, 0, 0)); }

// Deterministic correctly-rounded binary32 sqrt correction for positive finite inputs.
// Native sqrt() supplies a candidate; exact integer midpoint tests move it by at most 1 ULP.
// This avoids depending on backend-specific sqrt rounding while keeping the cost bounded.
bool rawrU64Less(uvec2 a, uvec2 b) { return (a.x < b.x) || ((a.x == b.x) && (a.y < b.y)); }
bool rawrU64Equal(uvec2 a, uvec2 b) { return a.x == b.x && a.y == b.y; }
uvec2 rawrMulU32(uint a, uint b) {
    uint hi, lo;
    umulExtended(a, b, hi, lo);
    return uvec2(hi, lo);
}
uvec2 rawrShiftLeft25(uint a) { return uvec2(a >> 7, a << 25); }
bool rawrExactKernelSqrt() { return false; }
bool rawrExactKernelHypot() { return false; }
bool rawrExactKernelAdd() { return false; }
bool rawrExactKernelMul() { return false; }
bool rawrExactKernelDiv() { return false; }
float rawrSqrtF32(float x) {
    if (!rawrExactKernelSqrt()) return sqrt(x);
    if (!(x > 0.0)) return x == 0.0 ? 0.0 : sqrt(x);
    uint xb = floatBitsToUint(x);
    uint xe = (xb >> 23) & 255u;
    uint xf = xb & 0x7fffffu;
    if (xe == 0u || xe == 255u) return sqrt(x);
    uint m = 0x800000u | xf;
    int E = int(xe) - 127;
    if ((E & 1) != 0) {
        m <<= 1;
        E -= 1;
    }
    int Ey = E / 2;
    uvec2 xs = rawrShiftLeft25(m);
    uint yb = floatBitsToUint(sqrt(x));
    for (int step = 0; step < 4; step++) {
        uint ye = (yb >> 23) & 255u, yf = yb & 0x7fffffu;
        int Yu = int(ye) - 127;
        uint q = 0x800000u | yf;
        if (Yu == Ey + 1)
            q <<= 1;
        else if (Yu != Ey)
            return uintBitsToFloat(yb);
        uint up = (q << 1) + 1u, dn = (q << 1) - 1u;
        uvec2 ups = rawrMulU32(up, up), dns = rawrMulU32(dn, dn);
        bool qOdd = (q & 1u) != 0u;
        if (rawrU64Less(ups, xs) || (rawrU64Equal(ups, xs) && qOdd)) {
            yb++;
            continue;
        }
        if (rawrU64Less(xs, dns) || (rawrU64Equal(xs, dns) && qOdd)) {
            yb--;
            continue;
        }
        break;
    }
    return uintBitsToFloat(yb);
}

// V3V CPU std::hypot emulation for binary32 inputs.  The V3U audit proved that
// sqrt(round(x*x+y*y)) is one ULP wrong for the companion target.  Recover the
// product/sum rounding residuals with FMA and apply one correctly-rounded Newton
// correction to the native/deterministic sqrt candidate.
float rawrHypotF32(float x, float y) {
    if (!rawrExactKernelHypot()) return length(vec2(x, y));
    precise float ax = abs(x), ay = abs(y);
    if (ay > ax) {
        precise float t = ax;
        ax = ay;
        ay = t;
    }
    if (ax == 0.0) return ay;
    precise float x2 = ax * ax, y2 = ay * ay;
    precise float ex = fma(ax, ax, -x2), ey = fma(ay, ay, -y2);
    precise float ss = x2 + y2;
    precise float es = (x2 - ss) + y2;
    precise float h = rawrSqrtF32(ss);
    precise float h2 = h * h;
    precise float eh = fma(h, h, -h2);
    precise float corr = (ex + ey) + es;
    precise float res = (ss - h2) + (corr - eh);
    return h + res / (2.0 * h);
}

// V3P deterministic binary32 add/multiply for finite normal parity-critical values.
// Integer significand arithmetic + explicit round-to-nearest-even. No backend FP contraction.
uint rawrShrSticky(uint v, uint s) {
    if (s == 0u) return v;
    if (s >= 32u) return v != 0u ? 1u : 0u;
    uint mask = (1u << s) - 1u;
    return (v >> s) | ((v & mask) != 0u ? 1u : 0u);
}
// Final-image parity is tolerant to native binary32 ULP variation.  Keep the
// algorithm and its explicit FMAs, but remove the per-operation integer
// significand emulation from the production candidate.
float rawrAddF32(float af, float bf) {
    if (!rawrExactKernelAdd()) return af + bf;
    uint ab = floatBitsToUint(af), bb = floatBitsToUint(bf);
    if ((ab & 0x7fffffffu) == 0u) return bf;
    if ((bb & 0x7fffffffu) == 0u) return af;
    uint ae = (ab >> 23) & 255u, be = (bb >> 23) & 255u;
    if (ae == 0u || be == 0u || ae == 255u || be == 255u) return af + bf;
    uint am = (0x800000u | (ab & 0x7fffffu)) << 3, bm = (0x800000u | (bb & 0x7fffffu)) << 3;
    uint asg = ab >> 31, bsg = bb >> 31;
    int e = int(ae);
    if (ae < be) {
        uint te = ae;
        ae = be;
        be = te;
        uint tm = am;
        am = bm;
        bm = tm;
        uint ts = asg;
        asg = bsg;
        bsg = ts;
        e = int(ae);
    }
    bm = rawrShrSticky(bm, ae - be);
    uint mm;
    uint sg = asg;
    if (asg == bsg) {
        mm = am + bm;
        if ((mm & 0x08000000u) != 0u) {
            mm = rawrShrSticky(mm, 1u);
            e++;
        }
    } else {
        if (am >= bm) {
            mm = am - bm;
        } else {
            mm = bm - am;
            sg = bsg;
        }
        if (mm == 0u) return 0.0;
        while ((mm & 0x04000000u) == 0u && e > 1) {
            mm <<= 1;
            e--;
        }
    }
    if (e <= 0 || e >= 255) return af + bf;
    uint base = mm >> 3, grs = mm & 7u;
    bool up = (grs > 4u) || (grs == 4u && ((base & 1u) != 0u));
    if (up) {
        base++;
        if (base == 0x1000000u) {
            base >>= 1;
            e++;
        }
    }
    return uintBitsToFloat((sg << 31) | (uint(e) << 23) | (base & 0x7fffffu));
}
float rawrMulF32(float af, float bf) {
    if (!rawrExactKernelMul()) return af * bf;
    uint ab = floatBitsToUint(af), bb = floatBitsToUint(bf);
    uint amag = ab & 0x7fffffffu, bmag = bb & 0x7fffffffu;
    if (amag == 0u || bmag == 0u) return uintBitsToFloat((ab ^ bb) & 0x80000000u);
    uint ae = (ab >> 23) & 255u, be = (bb >> 23) & 255u;
    if (ae == 0u || be == 0u || ae == 255u || be == 255u) return af * bf;
    uint am = 0x800000u | (ab & 0x7fffffu), bm = 0x800000u | (bb & 0x7fffffu);
    uint hi, lo;
    umulExtended(am, bm, hi, lo);
    int e = int(ae) + int(be) - 127;
    bool top = (hi & 0x00008000u) != 0u;
    uint sh = top ? 24u : 23u;
    if (top) e++;
    uint base;
    if (sh == 24u)
        base = (hi << 8) | (lo >> 24);
    else
        base = (hi << 9) | (lo >> 23);
    uint remMask = (1u << sh) - 1u;
    uint rem = lo & remMask;
    uint halfUlp = 1u << (sh - 1u);
    bool up = (rem > halfUlp) || (rem == halfUlp && ((base & 1u) != 0u));
    if (up) {
        base++;
        if (base == 0x1000000u) {
            base >>= 1;
            e++;
        }
    }
    if (e <= 0 || e >= 255) return af * bf;
    return uintBitsToFloat(((ab ^ bb) & 0x80000000u) | (uint(e) << 23) | (base & 0x7fffffu));
}

// Deterministic correctly-rounded binary32 division for finite normal values.
// The Metal fast-math divider can land one ULP away from the CPU result during
// eigenvector normalization.  Exact significand division keeps this path
// portable across Vulkan backends while preserving round-to-nearest-even.
float rawrDivF32(float af, float bf) {
    if (!rawrExactKernelDiv()) return af / bf;
    uint ab = floatBitsToUint(af), bb = floatBitsToUint(bf);
    uint amag = ab & 0x7fffffffu, bmag = bb & 0x7fffffffu;
    if (amag == 0u || bmag == 0u) return af / bf;
    uint ae = (ab >> 23) & 255u, be = (bb >> 23) & 255u;
    if (ae == 0u || be == 0u || ae == 255u || be == 255u) return af / bf;
    uint am = 0x800000u | (ab & 0x7fffffu), bm = 0x800000u | (bb & 0x7fffffu);
    int e = int(ae) - int(be) + 127;
    uint q, rem;
    int steps;
    if (am >= bm) {
        q = 1u;
        rem = am - bm;
        steps = 23;
    } else {
        q = 0u;
        rem = am;
        steps = 24;
        e--;
    }
    for (int k = 0; k < 24; k++) {
        if (k >= steps) break;
        rem <<= 1;
        q <<= 1;
        if (rem >= bm) {
            rem -= bm;
            q |= 1u;
        }
    }
    uint twice = rem << 1;
    bool up = (twice > bm) || (twice == bm && ((q & 1u) != 0u));
    if (up) {
        q++;
        if (q == 0x1000000u) {
            q >>= 1;
            e++;
        }
    }
    if (e <= 0 || e >= 255) return af / bf;
    return uintBitsToFloat(((ab ^ bb) & 0x80000000u) | (uint(e) << 23) | (q & 0x7fffffu));
}

layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 0, r32f) readonly uniform image2D rawI;
layout(set = 0, binding = 1, rgba32f) writeonly uniform image2D covI;
layout(push_constant) uniform P {
    vec4 alpha;
    vec4 beta;
    vec4 highAlpha;
    vec4 highBeta;
    vec4 knee;
    float kDetail, kDenoise, dThreshold, dTransition, kStretch, kShrink;
    float flatSigma, detailFloorEffective;
    int gw, gh;
}
p;
float gat(float v, ivec2 rawQ, ivec2 tq, uint aux) {
    uint phase = uint((rawQ.y & 1) * 2 + (rawQ.x & 1));
    bool high = p.knee[phase] > 0.0 && v >= p.knee[phase];
    precise float alpha = high ? p.highAlpha[phase] : p.alpha[phase], beta = high ? p.highBeta[phase] : p.beta[phase];
    precise float a0 = 0.375 * alpha;
    precise float t0 = a0 * alpha;
    // CPU Release expression permits contraction of alpha*v + the alpha^2 term.
    precise float t1 = fma(alpha, v, t0);
    precise float av = alpha * v;  // trace-only checkpoint; not used for t1
    precise float t2 = t1 + beta;
    precise float t = max(0.0, t2);
    precise float rt = rawrSqrtF32(t);
    precise float twoOver = 2.0 / alpha;
    precise float outv = twoOver * rt;
    if (high) {
        // A two-band sensor fit changes slope/offset at the measured knee. Shift the
        // high-band GAT by a constant so the transformed signal remains continuous.
        precise float k = p.knee[phase];
        precise float lowAlpha = p.alpha[phase], lowBeta = p.beta[phase];
        precise float lowT0 = (0.375 * lowAlpha) * lowAlpha;
        precise float highT0 = (0.375 * alpha) * alpha;
        precise float lowAtK = (2.0 / lowAlpha) * rawrSqrtF32(max(0.0, fma(lowAlpha, k, lowT0) + lowBeta));
        precise float highAtK = (2.0 / alpha) * rawrSqrtF32(max(0.0, fma(alpha, k, highT0) + beta));
        outv += lowAtK - highAtK;
    }
    rawrTrace4(2u, tq, aux, vec4(v, av, t0, 0));
    rawrTrace4(3u, tq, aux, vec4(t1, t2, rt, 0));
    rawrTrace1(4u, tq, aux, outv);
    return outv;
}
float grey(ivec2 q, ivec2 tq, uint aux) {
    q = clamp(q, ivec2(0), ivec2(p.gw - 1, p.gh - 1));
    ivec2 r = q * 2;
    precise float g00 = gat(imageLoad(rawI, r).x, r, tq, aux * 4u + 0u);
    precise float g10 = gat(imageLoad(rawI, r + ivec2(1, 0)).x, r + ivec2(1, 0), tq, aux * 4u + 1u);
    precise float g01 = gat(imageLoad(rawI, r + ivec2(0, 1)).x, r + ivec2(0, 1), tq, aux * 4u + 2u);
    precise float g11 = gat(imageLoad(rawI, r + ivec2(1)).x, r + ivec2(1), tq, aux * 4u + 3u);
    // V3O: literal CPU scalar `sum += gat(...)` order, starting from +0.
    precise float s0 = 0.0;
    s0 = rawrAddF32(s0, g00);
    precise float s1 = rawrAddF32(s0, g10);
    precise float s2 = rawrAddF32(s1, g01);
    precise float s3 = rawrAddF32(s2, g11);
    precise float outv = rawrMulF32(s3, 0.25);
    rawrTrace4(5u, tq, aux, vec4(g00, g10, g01, 0));
    rawrTrace4(6u, tq, aux, vec4(g11, s3, outv, 0));
    rawrTrace4(13u, tq, aux, vec4(s0, s1, s2, 0));
    return outv;
}
vec2 grad(ivec2 q, ivec2 tq, uint aux) {
    precise float a = grey(q, tq, aux * 4u + 0u), b = grey(q + ivec2(1, 0), tq, aux * 4u + 1u),
                  c = grey(q + ivec2(0, 1), tq, aux * 4u + 2u), d = grey(q + ivec2(1), tq, aux * 4u + 3u);
    precise float gx0 = rawrAddF32(-a, b);
    precise float gx1 = rawrAddF32(gx0, -c);
    precise float gx2 = rawrAddF32(gx1, d);
    precise float gy0 = rawrAddF32(-a, -b);
    precise float gy1 = rawrAddF32(gy0, c);
    precise float gy2 = rawrAddF32(gy1, d);
    precise float gx = rawrMulF32(0.25, gx2);
    precise float gy = rawrMulF32(0.25, gy2);
    rawrTrace4(7u, tq, aux, vec4(a, b, c, 0));
    rawrTrace4(8u, tq, aux, vec4(d, gx, gy, 0));
    return vec2(gx, gy);
}
void main() {
    ivec2 q = ivec2(gl_GlobalInvocationID.xy);
    rawrTrace4(1u, q, 0u, vec4(gl_GlobalInvocationID.xy, 0, 0));
    if (q.x >= p.gw || q.y >= p.gh) return;
    precise float a = 0, b = 0, d = 0;
    for (int j = 0; j < 2; j++)
        for (int i = 0; i < 2; i++) {
            ivec2 z = q - 1 + ivec2(i, j);
            uint tap = uint(j * 2 + i);
            if (any(lessThan(z, ivec2(0))) || z.x >= p.gw - 1 || z.y >= p.gh - 1) {
                rawrTrace4(9u, q, tap, vec4(float(z.x), float(z.y), -1, 0));
                continue;
            }
            precise vec2 g = grad(z, q, tap);
            // V3S: the live CPU build contracts `acc += g*g` into binary32 FMA.
            // The V3R exact-bit result proved the separate mul+add path is one ULP off
            // at cp20; explicit fma reproduces the observed CPU cp20 bits.
            precise float xx = rawrMulF32(g.x, g.x);
            precise float xy = rawrMulF32(g.x, g.y);
            precise float yy = rawrMulF32(g.y, g.y);
            rawrTrace4(10u, q, tap, vec4(g, xx, 0));
            rawrTrace4(11u, q, tap, vec4(xy, yy, float(z.x), 0));
            a = fma(g.x, g.x, a);
            b = fma(g.x, g.y, b);
            d = fma(g.y, g.y, d);
            rawrTrace4(12u, q, tap, vec4(a, b, d, 0));
        }
    precise float tr = a + d;
    precise float ad = a - d;
    precise float ad2 = ad * ad;
    precise float b4 = 4.0 * b;
    precise float bterm = b4 * b;
    // V3U: CPU discriminant is the FMA contract.
    precise float discArg = fma(ad, ad, bterm);
    precise float disc = rawrSqrtF32(max(0.0, discArg));
    precise float l1 = 0.5 * (tr + disc);
    precise float l2 = 0.5 * (tr - disc);
    rawrTrace4(20u, q, 0u, vec4(a, b, d, 0));
    rawrTrace4(21u, q, 0u, vec4(tr, discArg, disc, 0));
    rawrTrace4(22u, q, 0u, vec4(l1, l2, ad, 0));
    vec2 e1 = vec2(1, 0), e2 = vec2(0, 1);
    if (!(b == 0 && a == d)) {
        // Two equivalent eigenvectors. The old (J-l2*I)*(1,1) vanishes
        // on negative diagonal edges. Choose the longer candidate to avoid
        // cancellation near either coordinate axis as well as that diagonal.
        vec2 candidate0 = vec2(b, l1 - a);
        vec2 candidate1 = vec2(l1 - d, b);
        vec2 principal = dot(candidate0, candidate0) > dot(candidate1, candidate1)
                             ? candidate0 : candidate1;
        precise float e1x = principal.x;
        precise float e1y = principal.y;
        e1 = vec2(e1x, e1y);
        rawrTrace4(30u, q, 0u, vec4(e1x, e1y, 0, 0));
        if (e1.x == 0) {
            e1 = vec2(0, 1);
            e2 = vec2(1, 0);
        } else if (e1.y == 0) {
            e1 = vec2(1, 0);
            e2 = vec2(0, 1);
        } else {
            precise float n2 = e1.x * e1.x + e1.y * e1.y;
            precise float nn = rawrHypotF32(e1.x, e1.y);
            rawrTrace4(31u, q, 0u, vec4(n2, nn, 0, 0));
            e1 = vec2(rawrDivF32(e1.x, nn), rawrDivF32(e1.y, nn));
            float sg = e1.x < 0 ? -1 : 1;
            e2 = vec2(-e1.y * sg, abs(e1.x));
        }
    }
    rawrTrace4(32u, q, 0u, vec4(e1, e2.x, 0));
    rawrTrace1(33u, q, 0u, e2.y);
    precise float eigSum = l1 + l2;
    float A = 1.0;
    if (eigSum > 1e-30) {
        precise float eigDiff = l1 - l2;
        precise float anisotropy = rawrDivF32(eigDiff, eigSum);
        A = 1.0 + rawrSqrtF32(max(0.0, anisotropy));
    }
    precise float detailRoot = rawrSqrtF32(max(0.0, l1));
    precise float detailRatio = rawrDivF32(detailRoot, p.dTransition);
    float D = clamp((1.0 - detailRatio) + p.dThreshold, 0.0, 1.0);
    precise float shrinkDelta = rawrDivF32(1.0, p.kShrink) - 1.0;
    precise float stretchDelta = p.kStretch - 1.0;
    precise float blend = A - 1.0;
    float kk1 = fma(blend, shrinkDelta, 1.0), kk2 = fma(blend, stretchDelta, 1.0);
    precise float oneMinusD = 1.0 - D;
    precise float denoiseTerm = D * p.kDenoise;
    float k1 = p.kDetail * fma(oneMinusD, kk1, denoiseTerm), k2 = p.kDetail * fma(oneMinusD, kk2, denoiseTerm);
    if (p.flatSigma >= 0.0) {
        // Decoupled flat denoising: edge bandwidth stays kDetail-driven while
        // flat regions use an independent sigma. Legacy path (flatSigma < 0)
        // keeps kDetail*kDenoise so existing oracles stay bit-identical.
        float edge1 = p.kDetail * (oneMinusD * kk1), edge2 = p.kDetail * (oneMinusD * kk2);
        k1 = edge1 + D * p.flatSigma;
        k2 = edge2 + D * p.flatSigma;
    }
    if (p.detailFloorEffective > 0.0) {
        // Coverage/scale-aware floor (precomputed on CPU from
        // detailFloorSigma*(1+gain*(scale-1))): prevents the extremely narrow
        // sigma=kDetail/kShrink limit from sampling a single Bayer phase at
        // 2x or under poor coverage. Does not narrow kernels by itself.
        k1 = max(k1, p.detailFloorEffective);
        k2 = max(k2, p.detailFloorEffective);
    }
    float s1 = k1 * k1, s2 = k2 * k2;
    rawrTrace4(40u, q, 0u, vec4(A, D, kk1, 0));
    rawrTrace4(41u, q, 0u, vec4(kk2, k1, k2, 0));
    rawrTrace4(42u, q, 0u, vec4(s1, s2, 0, 0));
    // The frozen CPU build rounds each radius/vector product, rounds the complete
    // second covariance term, then fuses the first term into it.  FMA operand
    // order matters here; this mirrors the emitted ARM fmadd sequence exactly.
    precise float r1x = rawrMulF32(s1, e1.x), r2x = rawrMulF32(s2, e2.x);
    precise float cxx1 = rawrMulF32(r2x, e2.x);
    precise float cxx = fma(r1x, e1.x, cxx1);
    precise float cxy1 = rawrMulF32(r2x, e2.y);
    precise float cxy = fma(r1x, e1.y, cxy1);
    precise float r1y = rawrMulF32(s1, e1.y), r2y = rawrMulF32(s2, e2.y);
    precise float cyy1 = rawrMulF32(r2y, e2.y);
    precise float cyy = fma(r1y, e1.y, cyy1);
    rawrTrace4(50u, q, 0u, vec4(cxx, cxy, cyy, 0));
    imageStore(covI, q, vec4(cxx, cxy, cyy, 0));
    rawrTrace1(250u, q, 0u, 1.0);
}
