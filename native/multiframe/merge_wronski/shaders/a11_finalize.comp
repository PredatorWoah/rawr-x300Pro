    precise float g = w.y > 1e-12 ? rawrDivF32(s.y, w.y) : 0.0;
    precise float b = w.z > 1e-12 ? rawrDivF32(s.z, w.z) : 0.0;
    vec3 rgb = vec3(r, g, b);
    imageStore(outI, q, rawrRoundHalfRte(vec4(rgb, 1)));
    rawrTrace1(250u, q, 0u, 1.0);
}
