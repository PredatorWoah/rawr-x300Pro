#version 450

// RAWR parity scalar trace ABI. Normal production shaders compile this out.
#ifdef RAWR_PARITY_TRACE
layout(std430, set = 0, binding = 31) buffer RawrTraceBuffer {
    uint writeCount;
    uint droppedCount;
    uint _tracePad0;
    uint _tracePad1;
    uvec4 cfg0;
    ivec4 cfg1;
    uvec4 meta[];
}
rawrTrace;
const uint RAWR_TRACE_STAGE = 7u;
bool rawrTraceMatch(ivec2 q) {
    if (rawrTrace.cfg0.x == 0u) return false;
    if (rawrTrace.cfg0.y != 0u && rawrTrace.cfg0.y != RAWR_TRACE_STAGE) return false;
    int tx = int(rawrTrace.cfg0.z), ty = int(rawrTrace.cfg0.w);
    return (tx < 0 || q.x == tx) && (ty < 0 || q.y == ty);
}
void rawrTrace4(uint checkpoint, ivec2 q, uint aux, vec4 v) {
    if (!rawrTraceMatch(q)) return;
    uint i = atomicAdd(rawrTrace.writeCount, 1u);
    uint cap = uint(max(rawrTrace.cfg1.x, 0));
    if (i >= cap) {
        atomicAdd(rawrTrace.droppedCount, 1u);
        return;
    }
    uint b = i * 2u;
    rawrTrace.meta[b] = uvec4(RAWR_TRACE_STAGE, checkpoint, uint(q.x), uint(q.y));
    rawrTrace.meta[b + 1u] = uvec4(aux, floatBitsToUint(v.x), floatBitsToUint(v.y), floatBitsToUint(v.z));
}
#else
void rawrTrace4(uint checkpoint, ivec2 q, uint aux, vec4 v) {}
#endif
void rawrTrace1(uint checkpoint, ivec2 q, uint aux, float x) { rawrTrace4(checkpoint, q, aux, vec4(x, 0, 0, 0)); }
uint rawrHalfBitsRte(float v) {
    uint f = floatBitsToUint(v), sign = (f >> 16u) & 0x8000u, a = f & 0x7fffffffu;
    uint mant = a & 0x007fffffu, exp = (a >> 23u) & 0xffu;
    if (exp == 0xffu) {
        uint hm = mant >> 13u;
        if (mant != 0u && hm == 0u) hm = 1u;
        return sign | 0x7c00u | hm;
    }
    int he = int(exp) - 112;
    if (he <= 0) {
        if (he < -10) return sign;
        uint sig = mant | 0x00800000u, shift = uint(14 - he);
        uint q = sig >> shift, rem = sig & ((1u << shift) - 1u), mid = 1u << (shift - 1u);
        if (rem > mid || (rem == mid && (q & 1u) != 0u)) q++;
        return sign | q;
    }
    if (he >= 31) return sign | 0x7c00u;
    uint q = mant >> 13u, rem = mant & 0x1fffu;
    if (rem > 0x1000u || (rem == 0x1000u && (q & 1u) != 0u)) q++;
    if (q == 0x400u) {
        q = 0u;
        he++;
        if (he >= 31) return sign | 0x7c00u;
    }
    return sign | (uint(he) << 10u) | q;
}
float rawrHalfBitsToFloat(uint h) {
    uint sign = (h & 0x8000u) << 16u, exp = (h >> 10u) & 31u, mant = h & 0x3ffu;
    if (exp == 0u) {
        if (mant == 0u) return uintBitsToFloat(sign);
        int p = findMSB(mant);
        return uintBitsToFloat(sign | (uint(p + 103) << 23u) | ((mant - (1u << uint(p))) << uint(23 - p)));
    }
    if (exp == 31u) return uintBitsToFloat(sign | 0x7f800000u | (mant << 13u));
    return uintBitsToFloat(sign | ((exp + 112u) << 23u) | (mant << 13u));
}
float rawrRoundHalfRte(float v) { return rawrHalfBitsToFloat(rawrHalfBitsRte(v)); }
vec4 rawrRoundHalfRte(vec4 v) {
    return vec4(rawrRoundHalfRte(v.x), rawrRoundHalfRte(v.y), rawrRoundHalfRte(v.z), rawrRoundHalfRte(v.w));
}
float rawrDivF32(float af, float bf) {
    uint ab = floatBitsToUint(af), bb = floatBitsToUint(bf);
    uint amag = ab & 0x7fffffffu, bmag = bb & 0x7fffffffu;
    if (amag == 0u || bmag == 0u) return af / bf;
    uint ae = (ab >> 23) & 255u, be = (bb >> 23) & 255u;
    if (ae == 0u || be == 0u || ae == 255u || be == 255u) return af / bf;
    uint am = 0x800000u | (ab & 0x7fffffu), bm = 0x800000u | (bb & 0x7fffffu);
    int e = int(ae) - int(be) + 127;
    uint q, rem;
    int steps;
    if (am >= bm) {
        q = 1u;
        rem = am - bm;
        steps = 23;
    } else {
        q = 0u;
        rem = am;
        steps = 24;
        e--;
    }
    for (int j = 0; j < 24; j++) {
        if (j >= steps) break;
        rem <<= 1;
        q <<= 1;
        if (rem >= bm) {
            rem -= bm;
            q |= 1u;
        }
    }
    uint twice = rem << 1;
    bool up = (twice > bm) || (twice == bm && ((q & 1u) != 0u));
    if (up) {
        q++;
        if (q == 0x1000000u) {
            q >>= 1;
            e++;
        }
    }
    if (e <= 0 || e >= 255) return af / bf;
    return uintBitsToFloat(((ab ^ bb) & 0x80000000u) | (uint(e) << 23) | (q & 0x7fffffu));
}
layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 0, rgba32f) readonly uniform image2D sumI;
layout(set = 0, binding = 1, rgba32f) readonly uniform image2D weightI;
layout(set = 0, binding = 2, rgba16f) writeonly uniform image2D outI;
layout(push_constant) uniform P { int yBase; }
p;
void main() {
    ivec2 lq = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(lq, imageSize(sumI)))) return;
    ivec2 q = ivec2(lq.x, lq.y + p.yBase);
    rawrTrace4(1u, q, 0u, vec4(gl_GlobalInvocationID.xy, 0, 0));
    if (any(greaterThanEqual(q, imageSize(outI)))) return;
