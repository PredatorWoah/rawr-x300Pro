void main() {
    ivec2 q = ivec2(gl_GlobalInvocationID.xy);
    if (q.x >= p.w || q.y >= p.h) return;
    ivec2 rawQ = q * 2;
    ivec2 tile = clamp(rawQ / p.tileSize, ivec2(0), imageSize(tileFlow) - 1);
    uint op = 0u;
    vec2 flow;
    if (!smoothFlow(rawQ, op, flow)) {
        imageStore(pre, q, vec4(0));
        return;
    }
    precise float refLx0 = float(q.x) + 0.5;
    rawrOp(q, op, float(q.x), 0.5, refLx0);
    precise float refLy0 = float(q.y) + 0.5;
    rawrOp(q, op, float(q.y), 0.5, refLy0);
    precise float refHx = refLx0 * 0.5;
    rawrOp(q, op, refLx0, 0.5, refHx);
    precise float refLx = refHx - 0.5;
    rawrOp(q, op, refHx, 0.5, refLx);
    precise float refHy = refLy0 * 0.5;
    rawrOp(q, op, refLy0, 0.5, refHy);
    precise float refLy = refHy - 0.5;
    rawrOp(q, op, refHy, 0.5, refLy);
    vec2 refL = vec2(q);
    rawrTrace4(88u, q, 0u, vec4(flow.x, flow.y, 0, 0));
    precise float movX0 = rawrAddF32(float(q.x), flow.x);
    rawrOp(q, op, float(q.x), flow.x, movX0);
    precise float movY0 = rawrAddF32(float(q.y), flow.y);
    rawrOp(q, op, float(q.y), flow.y, movY0);
    precise float movX1 = rawrAddF32(movX0, 0.5);
    rawrOp(q, op, movX0, 0.5, movX1);
    precise float movY1 = rawrAddF32(movY0, 0.5);
    rawrOp(q, op, movY0, 0.5, movY1);
    precise float movHx = rawrMulF32(movX1, 0.5);
    rawrOp(q, op, movX1, 0.5, movHx);
    precise float movLx = rawrAddF32(movHx, -0.5);
    rawrOp(q, op, movHx, -0.5, movLx);
    precise float movHy = rawrMulF32(movY1, 0.5);
    rawrOp(q, op, movY1, 0.5, movHy);
    precise float movLy = rawrAddF32(movHy, -0.5);
    rawrOp(q, op, movHy, -0.5, movLy);
    vec2 movL = vec2(q) + flow * .5;
    vec3 a, v, b;
    rawrTrace4(80u, q, 0u, vec4(refL, movL.x, 0));
    rawrTrace1(81u, q, 0u, movL.y);
    if (!warpRefStats(refL, q, op, a, v) || !warpMovMean(movL, q, op, b)) {
        imageStore(pre, q, vec4(0));
        return;
    }
    rawrTrace4(90u, q, 0u, vec4(a, 0));
    rawrTrace4(91u, q, 0u, vec4(v, 0));
    rawrTrace4(92u, q, 0u, vec4(b, 0));
    if (any(isnan(a)) || any(isinf(a)) || any(isnan(v)) || any(isinf(v)) || any(isnan(b)) || any(isinf(b))) {
        imageStore(pre, q, vec4(0));
        return;
    }
    precise float ds = 0, ss = 0;

        // Upstream 1.4 indexes one aggregate Monte-Carlo curve by the mean
        // perceptual brightness, then corrects aggregate RGB distance/variance.
        precise float brightness = clamp((a.x + a.y + a.z) / 3.0, 0.0, 1.0);
        int ni = clamp(int(roundEven(1000.0 * brightness)), 0, 1000);
        vec3 delta = a - b;
        precise float distanceNoiseSquared = diffc[ni];
        precise float sigmaNoiseSquared = stdc[ni];
#ifdef RAWR_MIN_GATE
        vec3 dsc = delta * delta;
        vec3 vwc = max(v, vec3(sigmaNoiseSquared));
        vec3 shr = dsc / (dsc + vec3(distanceNoiseSquared));
        dsc *= shr * shr;
        precise float maxNorm = max(dsc.x / vwc.x, max(dsc.y / vwc.y, dsc.z / vwc.z));
        ds = maxNorm;
        ss = 1.0;
#else
        ds = dot(delta, delta);
        ss = v.x + v.y + v.z;
        ss = max(ss, sigmaNoiseSquared);
        if (ds > 0.0) {
            precise float shrink = ds / (ds + distanceNoiseSquared);
            ds *= shrink * shrink;
        }
#endif
        rawrTrace4(110u, q, 0u, vec4(brightness, float(ni), distanceNoiseSquared, sigmaNoiseSquared));
        rawrTrace4(111u, q, 0u, vec4(delta, ds));
    
    precise float scale = imageLoad(scaleTile, tile).x;
    precise float norm = rawrDivF32(ds, ss);
    rawrOp(q, op, ds, ss, norm);
    precise float negNorm = -norm;
    rawrOp(q, op, norm, -1.0, negNorm);
    precise float ee = exp(negNorm);
    rawrOp(q, op, negNorm, 0.0, ee);
    // CPU source is `scale * exp(-norm) - t`; preserve separate binary32 rounding.
    precise float r0 = rawrMulF32(scale, ee);
    rawrOp(q, op, scale, ee, r0);
    precise float r = rawrAddF32(r0, -p.t);
    rawrOp(q, op, r0, -p.t, r);
    rawrTrace4(120u, q, 0u, vec4(flow, ds, ss));
    rawrTrace4(121u, q, 0u, vec4(scale, r, float(tile.x), float(tile.y)));
    rawrTrace4(122u, q, 0u, vec4(norm, ee, r, 0));
    imageStore(pre, q, vec4(clamp(r, 0, 1)));
}
