#version 450

// RAWR parity scalar trace ABI. Normal production shaders compile this out.
#ifdef RAWR_PARITY_TRACE
layout(std430, set = 0, binding = 31) buffer RawrTraceBuffer {
    uint writeCount;
    uint droppedCount;
    uint _tracePad0;
    uint _tracePad1;
    uvec4 cfg0;
    ivec4 cfg1;
    uvec4 meta[];
}
rawrTrace;
const uint RAWR_TRACE_STAGE = 19u;
bool rawrTraceMatch(ivec2 q) {
    if (rawrTrace.cfg0.x == 0u) return false;
    if (rawrTrace.cfg0.y != 0u && rawrTrace.cfg0.y != RAWR_TRACE_STAGE) return false;
    int tx = int(rawrTrace.cfg0.z), ty = int(rawrTrace.cfg0.w);
    return (tx < 0 || q.x == tx) && (ty < 0 || q.y == ty);
}
void rawrTrace4(uint checkpoint, ivec2 q, uint aux, vec4 v) {
    if (!rawrTraceMatch(q)) return;
    uint i = atomicAdd(rawrTrace.writeCount, 1u);
    uint cap = uint(max(rawrTrace.cfg1.x, 0));
    if (i >= cap) {
        atomicAdd(rawrTrace.droppedCount, 1u);
        return;
    }
    uint b = i * 2u;
    rawrTrace.meta[b] = uvec4(RAWR_TRACE_STAGE, checkpoint, uint(q.x), uint(q.y));
    rawrTrace.meta[b + 1u] = uvec4(aux, floatBitsToUint(v.x), floatBitsToUint(v.y), floatBitsToUint(v.z));
}
#else
void rawrTrace4(uint checkpoint, ivec2 q, uint aux, vec4 v) {}
#endif
void rawrTrace1(uint checkpoint, ivec2 q, uint aux, float x) { rawrTrace4(checkpoint, q, aux, vec4(x, 0, 0, 0)); }

// Correctly-rounded binary32 division by 9 for non-negative normal inputs.
// The CPU oracle performs float / 9.0f; reciprocal multiplication is not equivalent
// at all rounding boundaries, so compute the quotient from the IEEE-754 significand.
float rawrDiv9F32(float x) {
    if (x == 0.0) return 0.0;
    uint xb = floatBitsToUint(x);
    uint e = (xb >> 23) & 255u;
    uint f = xb & 0x7fffffu;
    if ((xb >> 31) != 0u || e == 0u || e == 255u) return x / 9.0;  // not exercised by stats sums
    uint m = 0x800000u | f;
    // Choose shift so rounded quotient has a normalized 24-bit significand.
    uint sh = (m >= 9437184u) ? 3u : 4u;  // threshold = 9*2^20
    uint n = m << sh;
    uint q = n / 9u;
    uint r = n - q * 9u;
    if (r * 2u > 9u || (r * 2u == 9u && (q & 1u) != 0u)) q += 1u;
    int ue = int(e) - 127 - int(sh);
    if (q >= 0x1000000u) {
        q >>= 1;
        ue += 1;
    }
    int be = ue + 127;
    if (be <= 0 || be >= 255) return x / 9.0;
    return uintBitsToFloat((uint(be) << 23) | (q & 0x7fffffu));
}

layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 0, rgba32f) readonly uniform image2D guide;
layout(set = 0, binding = 1, rgba32f) writeonly uniform image2D meanI;
layout(set = 0, binding = 2, rgba32f) writeonly uniform image2D varI;
void main() {
    ivec2 q = ivec2(gl_GlobalInvocationID.xy);
    rawrTrace4(1u, q, 0u, vec4(gl_GlobalInvocationID.xy, 0, 0));
    if (any(greaterThanEqual(q, imageSize(guide)))) return;
    precise float s0 = 0.0, s1 = 0.0, s2 = 0.0, ss0 = 0.0, ss1 = 0.0, ss2 = 0.0;
    for (int y = -1; y <= 1; y++)
        for (int x = -1; x <= 1; x++) {
            vec3 v = imageLoad(guide, clamp(q + ivec2(x, y), ivec2(0), imageSize(guide) - 1)).xyz;
            precise float v0 = v.x, v1 = v.y, v2 = v.z;
            uint tap = uint((y + 1) * 3 + (x + 1));
            rawrTrace4(60u, q, tap, vec4(v0, v1, v2, 0));
            // Force one correctly-rounded add per CPU `sum += q`; fma(x,1,s) prevents
            // reassociation while being numerically the same operation in binary32.
            s0 = fma(v0, 1.0, s0);
            s1 = fma(v1, 1.0, s1);
            s2 = fma(v2, 1.0, s2);
            // V3V: V3U contract audit proved CPU `sumSq += q*q` follows fused multiply-add.
            precise float q0 = v0 * v0, q1 = v1 * v1, q2 = v2 * v2;  // trace-only products
            ss0 = fma(v0, v0, ss0);
            ss1 = fma(v1, v1, ss1);
            ss2 = fma(v2, v2, ss2);
            rawrTrace4(61u, q, tap, vec4(s0, s1, s2, 0));
            rawrTrace4(62u, q, tap, vec4(ss0, ss1, ss2, 0));
        }
    precise float m0 = rawrDiv9F32(s0), m1 = rawrDiv9F32(s1), m2 = rawrDiv9F32(s2);
    precise float d0 = rawrDiv9F32(ss0), d1 = rawrDiv9F32(ss1), d2 = rawrDiv9F32(ss2);
    // V3U proved the live CPU variance expression contracts as div - mean*mean.
    precise float v0 = fma(-m0, m0, d0), v1 = fma(-m1, m1, d1), v2 = fma(-m2, m2, d2);
    rawrTrace4(63u, q, 0u, vec4(s0, s1, s2, 0));
    rawrTrace4(64u, q, 0u, vec4(m0, m1, m2, 0));
    rawrTrace4(65u, q, 0u, vec4(v0, v1, v2, 0));
    imageStore(meanI, q, vec4(m0, m1, m2, 0));
    imageStore(varI, q, vec4(v0, v1, v2, 0));
    rawrTrace1(250u, q, 0u, 1.0);
}
