#version 450

// Robust IRLS affine fit using native float and a compact residual
// histogram instead of repeatedly radix-sorting float-float pairs.

#define LANES 128u
#define HISTOGRAM_BINS 128u
#define HISTOGRAM_STEP 0.125

layout(local_size_x = LANES, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, rg32f) readonly uniform image2D tileFlow;
layout(set = 0, binding = 1, r8ui) readonly uniform uimage2D validI;
layout(std430, set = 0, binding = 2) buffer Weights { float weights[]; };
layout(std430, set = 0, binding = 3) buffer Residuals { float residuals[]; };
layout(std430, set = 0, binding = 4) buffer Scratch { float scratch[]; };
layout(std430, set = 0, binding = 5) buffer Out { float v[16]; } outp;
layout(push_constant) uniform P {
    int imageW;
    int imageH;
    float tileSize;
} pc;

shared vec4 reduce0[LANES];
shared vec4 reduce1[LANES];
shared vec4 reduce2[LANES];
shared float normal[12];
shared float model[6];
shared float robustMedian;
shared float robustMad;
shared float robustScale;
shared uint validCount;
shared uint histogram[HISTOGRAM_BINS];

vec2 normalizedTileCoordinate(ivec2 q) {
    return 2.0 * ((vec2(q) + 0.5) * pc.tileSize) / vec2(pc.imageW, pc.imageH) - 1.0;
}

void reduceNormal(vec4 a, vec4 b, vec4 c) {
    uint lane = gl_LocalInvocationID.x;
    reduce0[lane] = a;
    reduce1[lane] = b;
    reduce2[lane] = c;
    barrier();
    for (uint stride = LANES / 2u; stride > 0u; stride >>= 1u) {
        if (lane < stride) {
            reduce0[lane] += reduce0[lane + stride];
            reduce1[lane] += reduce1[lane + stride];
            reduce2[lane] += reduce2[lane + stride];
        }
        barrier();
    }
    if (lane == 0u) {
        for (int component = 0; component < 4; ++component) {
            normal[component] = reduce0[0][component];
            normal[4 + component] = reduce1[0][component];
            normal[8 + component] = reduce2[0][component];
        }
    }
    barrier();
}

bool solve3(inout float a[9], inout float b[3], out float x[3]) {
    for (int column = 0; column < 3; ++column) {
        int pivot = column;
        float best = abs(a[column * 3 + column]);
        for (int row = column + 1; row < 3; ++row) {
            float candidate = abs(a[row * 3 + column]);
            if (candidate > best) {
                best = candidate;
                pivot = row;
            }
        }
        if (!(best > 1e-8)) return false;
        if (pivot != column) {
            for (int j = 0; j < 3; ++j) {
                float temporary = a[pivot * 3 + j];
                a[pivot * 3 + j] = a[column * 3 + j];
                a[column * 3 + j] = temporary;
            }
            float temporary = b[pivot];
            b[pivot] = b[column];
            b[column] = temporary;
        }
        float inverse = 1.0 / a[column * 3 + column];
        for (int j = column; j < 3; ++j) a[column * 3 + j] *= inverse;
        b[column] *= inverse;
        for (int row = 0; row < 3; ++row) {
            if (row == column) continue;
            float factor = a[row * 3 + column];
            for (int j = column; j < 3; ++j) a[row * 3 + j] -= factor * a[column * 3 + j];
            b[row] -= factor * b[column];
        }
    }
    x[0] = b[0];
    x[1] = b[1];
    x[2] = b[2];
    return true;
}

float approximateMedian(int total, uint count, bool deviation, float center) {
    uint lane = gl_LocalInvocationID.x;
    for (uint bin = lane; bin < HISTOGRAM_BINS; bin += LANES) histogram[bin] = 0u;
    barrier();
    ivec2 dimensions = imageSize(tileFlow);
    for (int sampleIndex = int(lane); sampleIndex < total; sampleIndex += int(LANES)) {
        ivec2 q = ivec2(sampleIndex % dimensions.x, sampleIndex / dimensions.x);
        if (imageLoad(validI, q).x == 0u) continue;
        float value = deviation ? abs(residuals[sampleIndex] - center) : residuals[sampleIndex];
        uint bin = uint(clamp(int(value / HISTOGRAM_STEP), 0, int(HISTOGRAM_BINS) - 1));
        atomicAdd(histogram[bin], 1u);
    }
    barrier();
    if (lane == 0u) {
        uint target = (count - 1u) / 2u;
        uint cumulative = 0u;
        uint selected = HISTOGRAM_BINS - 1u;
        for (uint bin = 0u; bin < HISTOGRAM_BINS; ++bin) {
            cumulative += histogram[bin];
            if (cumulative > target) {
                selected = bin;
                break;
            }
        }
        scratch[0] = (float(selected) + 0.5) * HISTOGRAM_STEP;
    }
    barrier();
    return scratch[0];
}

void main() {
    uint lane = gl_LocalInvocationID.x;
    ivec2 dimensions = imageSize(tileFlow);
    int total = dimensions.x * dimensions.y;
    if (lane == 0u) validCount = 0u;
    barrier();
    uint laneValid = 0u;
    for (int sampleIndex = int(lane); sampleIndex < total; sampleIndex += int(LANES)) {
        ivec2 q = ivec2(sampleIndex % dimensions.x, sampleIndex / dimensions.x);
        bool valid = imageLoad(validI, q).x != 0u;
        weights[sampleIndex] = valid ? 1.0 : 0.0;
        laneValid += valid ? 1u : 0u;
    }
    atomicAdd(validCount, laneValid);
    barrier();
    if (validCount < 32u) {
        if (lane == 0u) {
            for (int i = 0; i < 16; ++i) outp.v[i] = 0.0;
            outp.v[8] = 1e6;
        }
        return;
    }

    for (int iteration = 0; iteration < 4; ++iteration) {
        vec4 sums0 = vec4(0.0), sums1 = vec4(0.0), sums2 = vec4(0.0);
        for (int sampleIndex = int(lane); sampleIndex < total; sampleIndex += int(LANES)) {
            ivec2 q = ivec2(sampleIndex % dimensions.x, sampleIndex / dimensions.x);
            if (imageLoad(validI, q).x == 0u) continue;
            vec2 coordinate = normalizedTileCoordinate(q);
            vec2 flow = imageLoad(tileFlow, q).xy;
            float w = weights[sampleIndex], x = coordinate.x, y = coordinate.y;
            sums0 += vec4(w, w * x, w * y, w * x * x);
            sums1 += vec4(w * x * y, w * y * y, w * flow.x, w * x * flow.x);
            sums2 += vec4(w * y * flow.x, w * flow.y, w * x * flow.y, w * y * flow.y);
        }
        reduceNormal(sums0, sums1, sums2);
        if (lane == 0u) {
            float ax[9] = float[9](normal[0], normal[1], normal[2],
                                   normal[1], normal[3], normal[4],
                                   normal[2], normal[4], normal[5]);
            float ay[9] = float[9](normal[0], normal[1], normal[2],
                                   normal[1], normal[3], normal[4],
                                   normal[2], normal[4], normal[5]);
            float bx[3] = float[3](normal[6], normal[7], normal[8]);
            float by[3] = float[3](normal[9], normal[10], normal[11]);
            float mx[3], my[3];
            bool solvedX = solve3(ax, bx, mx);
            bool solvedY = solve3(ay, by, my);
            for (int i = 0; i < 3; ++i) {
                model[i] = solvedX ? mx[i] : 0.0;
                model[3 + i] = solvedY ? my[i] : 0.0;
            }
        }
        barrier();

        for (int sampleIndex = int(lane); sampleIndex < total; sampleIndex += int(LANES)) {
            ivec2 q = ivec2(sampleIndex % dimensions.x, sampleIndex / dimensions.x);
            if (imageLoad(validI, q).x == 0u) {
                residuals[sampleIndex] = 0.0;
                continue;
            }
            vec2 coordinate = normalizedTileCoordinate(q);
            vec2 predicted = vec2(model[0] + model[1] * coordinate.x + model[2] * coordinate.y,
                                  model[3] + model[4] * coordinate.x + model[5] * coordinate.y);
            residuals[sampleIndex] = length(imageLoad(tileFlow, q).xy - predicted);
        }
        barrier();
        float median = approximateMedian(total, validCount, false, 0.0);
        float mad = approximateMedian(total, validCount, true, median);
        if (lane == 0u) {
            robustMedian = median;
            robustMad = mad;
            robustScale = max(1.4826 * mad, 0.35);
        }
        barrier();
        float huber = 1.5 * robustScale;
        for (int sampleIndex = int(lane); sampleIndex < total; sampleIndex += int(LANES)) {
            ivec2 q = ivec2(sampleIndex % dimensions.x, sampleIndex / dimensions.x);
            if (imageLoad(validI, q).x == 0u) continue;
            float residual = residuals[sampleIndex];
            weights[sampleIndex] = residual <= huber ? 1.0 : huber / max(residual, 1e-6);
        }
        barrier();
    }

    if (lane == 0u) {
        for (int i = 0; i < 16; ++i) outp.v[i] = 0.0;
        for (int i = 0; i < 6; ++i) outp.v[i] = model[i];
        outp.v[6] = robustMedian;
        outp.v[7] = robustMad;
        outp.v[8] = robustScale;
    }
}
