#version 450

// Native-float affine gate matching the fit model/output ABI.
layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 0, rg32f) readonly uniform image2D tileFlow;
layout(set = 0, binding = 1, r8ui) readonly uniform uimage2D validI;
layout(set = 0, binding = 2, r32f) readonly uniform image2D robust;
layout(set = 0, binding = 3, r32f) writeonly uniform image2D gated;
layout(std430, set = 0, binding = 4) readonly buffer Model { float v[16]; } model;
layout(set = 0, binding = 5, rgba32f) readonly uniform image2D tileTensor;
layout(push_constant) uniform P {
    int imageW;
    int imageH;
    int tileSize;
    float deadzoneSigma;
    float softnessSigma;
    int apertureAware;
} pc;

bool smoothFlow(ivec2 q, out vec2 flow) {
    vec2 grid = (vec2(q) + 0.5) / float(pc.tileSize) - 0.5;
    ivec2 base = ivec2(floor(grid));
    vec2 fraction = grid - vec2(base);
    vec2 accumulated = vec2(0.0);
    float total = 0.0;
    for (int y = 0; y < 2; ++y) {
        for (int x = 0; x < 2; ++x) {
            ivec2 tile = clamp(base + ivec2(x, y), ivec2(0), imageSize(tileFlow) - 1);
            if (imageLoad(validI, tile).x == 0u) continue;
            float weight = (x == 0 ? 1.0 - fraction.x : fraction.x) *
                           (y == 0 ? 1.0 - fraction.y : fraction.y);
            accumulated += weight * imageLoad(tileFlow, tile).xy;
            total += weight;
        }
    }
    if (!(total > 1e-8)) return false;
    flow = accumulated / total;
    return true;
}

// Same bilinear tile weights as smoothFlow, for the reference structure tensor.
vec4 smoothTensor(ivec2 q) {
    vec2 grid = (vec2(q) + 0.5) / float(pc.tileSize) - 0.5;
    ivec2 base = ivec2(floor(grid));
    vec2 fraction = grid - vec2(base);
    vec4 accumulated = vec4(0.0);
    for (int y = 0; y < 2; ++y) {
        for (int x = 0; x < 2; ++x) {
            ivec2 tile = clamp(base + ivec2(x, y), ivec2(0), imageSize(tileTensor) - 1);
            float weight = (x == 0 ? 1.0 - fraction.x : fraction.x) *
                           (y == 0 ? 1.0 - fraction.y : fraction.y);
            accumulated += weight * imageLoad(tileTensor, tile);
        }
    }
    return accumulated;
}

// Residual length along the directions the tile can actually measure.
// The structure tensor minus its expected noise energy (w) gives the signal
// eigenvalues; each residual component is weighted by how well that axis is
// constrained relative to the best one. Edge-only tiles (slats, stripes) drop
// the along-edge component. Tiles whose structure is all noise (smooth skin,
// flat walls) keep the full isotropic check: photometric robustness alone
// does not catch a smooth moving subject over similar-toned content.
float resolvableResidual(ivec2 q, vec2 d) {
    vec4 a = smoothTensor(q);
    float halfTrace = 0.5 * (a.x + a.z);
    float halfDiff = 0.5 * (a.x - a.z);
    float radius = sqrt(halfDiff * halfDiff + a.y * a.y);
    float signalMax = max(halfTrace + radius - a.w, 0.0);
    float signalMin = max(halfTrace - radius - a.w, 0.0);
    if (!(signalMax > a.w * 0.25 + 1e-20)) return length(d);
    float angle = 0.5 * atan(2.0 * a.y, a.x - a.z);
    vec2 major = vec2(cos(angle), sin(angle));
    vec2 minor = vec2(-major.y, major.x);
    float alongMajor = dot(d, major);
    float alongMinor = dot(d, minor);
    return sqrt(alongMajor * alongMajor + (signalMin / signalMax) * alongMinor * alongMinor);
}

void main() {
    ivec2 q = ivec2(gl_GlobalInvocationID.xy);
    if (q.x >= pc.imageW || q.y >= pc.imageH) return;
    vec2 flow;
    if (!smoothFlow(q, flow)) {
        imageStore(gated, q, vec4(0.0));
        return;
    }
    vec2 coordinate = 2.0 * (vec2(q) + 0.5) / vec2(pc.imageW, pc.imageH) - 1.0;
    vec2 predicted = vec2(model.v[0] + model.v[1] * coordinate.x + model.v[2] * coordinate.y,
                          model.v[3] + model.v[4] * coordinate.x + model.v[5] * coordinate.y);
    vec2 delta = flow - predicted;
    float residual = pc.apertureAware != 0 ? resolvableResidual(q, delta) : length(delta);
    float scale = max(model.v[8], 0.35);
    float excess = max(residual - pc.deadzoneSigma * scale, 0.0);
    float softness = max(pc.softnessSigma * scale, 0.25);
    float normalized = excess / softness;
    float gate = exp(-0.5 * normalized * normalized);
    imageStore(gated, q, vec4(clamp(imageLoad(robust, q).x * gate, 0.0, 1.0)));
}
