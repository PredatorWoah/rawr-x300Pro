#version 450
#ifdef RAWR_PARITY_TRACE
layout(std430, set = 0, binding = 31) buffer RawrTraceBuffer {
    uint writeCount;
    uint droppedCount;
    uint _p0;
    uint _p1;
    uvec4 cfg0;
    ivec4 cfg1;
    uvec4 meta[];
}
rawrTrace;
const uint RAWR_TRACE_STAGE = 11u;
bool rawrTraceMatch(ivec2 q) {
    if (rawrTrace.cfg0.x == 0u) return false;
    if (rawrTrace.cfg0.y != 0u && rawrTrace.cfg0.y != RAWR_TRACE_STAGE) return false;
    int tx = int(rawrTrace.cfg0.z), ty = int(rawrTrace.cfg0.w);
    return (tx < 0 || q.x == tx) && (ty < 0 || q.y == ty);
}
void rawrTrace4(uint cp, ivec2 q, uint aux, vec4 v) {
    if (!rawrTraceMatch(q)) return;
    uint i = atomicAdd(rawrTrace.writeCount, 1u);
    uint cap = uint(max(rawrTrace.cfg1.x, 0));
    if (i >= cap) {
        atomicAdd(rawrTrace.droppedCount, 1u);
        return;
    }
    uint b = i * 2u;
    rawrTrace.meta[b] = uvec4(RAWR_TRACE_STAGE, cp, uint(q.x), uint(q.y));
    rawrTrace.meta[b + 1u] = uvec4(aux, floatBitsToUint(v.x), floatBitsToUint(v.y), floatBitsToUint(v.z));
}
#else
void rawrTrace4(uint cp, ivec2 q, uint aux, vec4 v) {}
#endif
layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 0, rg32f) readonly uniform image2D tileFlow;
layout(set = 0, binding = 1, r8ui) readonly uniform uimage2D valid;
layout(set = 0, binding = 2, r32f) writeonly uniform image2D scaleI;
layout(push_constant) uniform P {
    float s1, s2, threshold;
    int tilesX;
    int tilesY;
}
p;
void main() {
    ivec2 t = ivec2(gl_GlobalInvocationID.xy);
    if (t.x >= p.tilesX || t.y >= p.tilesY) return;
    vec2 mn = vec2(1.0 / 0.0), mx = vec2(-1.0 / 0.0);
    bool anyv = false;
    for (int y = -1; y <= 1; y++)
        for (int x = -1; x <= 1; x++) {
            ivec2 z = t + ivec2(x, y);
            if (any(lessThan(z, ivec2(0))) || any(greaterThanEqual(z, imageSize(tileFlow))) ||
                imageLoad(valid, z).x == 0u)
                continue;
            vec2 f = imageLoad(tileFlow, z).xy;
            mn = min(mn, f);
            mx = max(mx, f);
            anyv = true;
        }
    float d2 = anyv ? dot(mx - mn, mx - mn) : 0.0;
    float s = (!anyv || imageLoad(valid, t).x == 0u) ? 0.0 : (d2 > p.threshold * p.threshold ? p.s1 : p.s2);
    imageStore(scaleI, t, vec4(s));
    rawrTrace4(100u, t, 0u, vec4(mn, mx.x, 0));
    rawrTrace4(101u, t, 0u, vec4(mx.y, d2, s, 0));
}
