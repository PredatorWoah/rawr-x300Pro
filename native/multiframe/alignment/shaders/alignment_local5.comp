#version 450

layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 0, r32f) readonly uniform image2D sourceImage;
layout(set = 0, binding = 1, r32f) writeonly uniform image2D destinationImage;

layout(push_constant) uniform Parameters {
    int axis;
    int width;
    int height;
}
parameters;

float sourceAt(ivec2 q, int offset) {
    ivec2 samplePoint = q;
    if (parameters.axis == 0)
        samplePoint.x += offset;
    else
        samplePoint.y += offset;
    samplePoint = clamp(samplePoint, ivec2(0), ivec2(parameters.width - 1, parameters.height - 1));
    return imageLoad(sourceImage, samplePoint).x;
}

// Reproduce correctly-rounded (6*x)+addend without relying on the driver's
// fused-multiply-add implementation.  The products 4*x and 2*x are exact for
// finite binary32 inputs; TwoSum then retains the product and addition errors
// long enough for the final round-to-nearest-even result.  This is materially
// cheaper than widening the full image pass and reproduces the frozen CPU
// binary32 operation without a driver-specific FMA dependency.
float exactFma6(float x, float addend) {
    precise float product4 = 4.0 * x;
    precise float product2 = 2.0 * x;
    precise float productHigh = product4 + product2;
    precise float productBridge = productHigh - product4;
    precise float productLow = (product4 - (productHigh - productBridge)) + (product2 - productBridge);

    precise float sumHigh = addend + productHigh;
    precise float sumBridge = sumHigh - addend;
    precise float sumLow = (addend - (sumHigh - sumBridge)) + (productHigh - sumBridge);
    precise float low = sumLow + productLow;
    precise float result = sumHigh + low;
    return result;
}

void main() {
    const ivec2 q = ivec2(gl_GlobalInvocationID.xy);
    if (q.x >= parameters.width || q.y >= parameters.height) return;

    // Literal source order and binary32 rounding contract of the frozen CPU
    // local5 [1 4 6 4 1] / 16 pass.
    precise float sum = sourceAt(q, -2);
    precise float term1 = 4.0 * sourceAt(q, -1);
    sum = sum + term1;
    sum = exactFma6(sourceAt(q, 0), sum);
    precise float term3 = 4.0 * sourceAt(q, 1);
    sum = sum + term3;
    sum = sum + sourceAt(q, 2);
    imageStore(destinationImage, q, vec4(sum * 0.0625));
}
