#version 450

// RAWR parity scalar trace ABI. Normal production shaders compile this out.
#ifdef RAWR_PARITY_TRACE
layout(std430, set = 0, binding = 31) buffer RawrTraceBuffer {
    uint writeCount;
    uint droppedCount;
    uint _tracePad0;
    uint _tracePad1;
    uvec4 cfg0;
    ivec4 cfg1;
    uvec4 meta[];
}
rawrTrace;
const uint RAWR_TRACE_STAGE = 3u;
bool rawrTraceMatch(ivec2 q) {
    if (rawrTrace.cfg0.x == 0u) return false;
    if (rawrTrace.cfg0.y != 0u && rawrTrace.cfg0.y != RAWR_TRACE_STAGE) return false;
    int tx = int(rawrTrace.cfg0.z), ty = int(rawrTrace.cfg0.w);
    return (tx < 0 || q.x == tx) && (ty < 0 || q.y == ty);
}
void rawrTrace4(uint checkpoint, ivec2 q, uint aux, vec4 v) {
    if (!rawrTraceMatch(q)) return;
    uint i = atomicAdd(rawrTrace.writeCount, 1u);
    uint cap = uint(max(rawrTrace.cfg1.x, 0));
    if (i >= cap) {
        atomicAdd(rawrTrace.droppedCount, 1u);
        return;
    }
    uint b = i * 2u;
    rawrTrace.meta[b] = uvec4(RAWR_TRACE_STAGE, checkpoint, uint(q.x), uint(q.y));
    rawrTrace.meta[b + 1u] = uvec4(aux, floatBitsToUint(v.x), floatBitsToUint(v.y), floatBitsToUint(v.z));
}
#else
void rawrTrace4(uint checkpoint, ivec2 q, uint aux, vec4 v) {}
#endif
void rawrTrace1(uint checkpoint, ivec2 q, uint aux, float x) { rawrTrace4(checkpoint, q, aux, vec4(x, 0, 0, 0)); }
layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 0, rg32f) readonly uniform image2D coarse;
layout(set = 0, binding = 1, rg32f) writeonly uniform image2D fine;
layout(push_constant) uniform P {
    int repeatFactor;
    int flowScale;
    int w;
    int h;
}
p;
void main() {
    ivec2 q = ivec2(gl_GlobalInvocationID.xy);
    rawrTrace4(1u, q, 0u, vec4(gl_GlobalInvocationID.xy, 0, 0));
    if (q.x >= p.w || q.y >= p.h) return;
    vec2 g = (vec2(q) + .5) / float(p.repeatFactor) - .5;
    ivec2 b = ivec2(floor(g));
    vec2 f = g - vec2(b);
    ivec2 hi = imageSize(coarse) - 1;
    vec2 v00 = imageLoad(coarse, clamp(b, ivec2(0), hi)).xy;
    vec2 v10 = imageLoad(coarse, clamp(b + ivec2(1, 0), ivec2(0), hi)).xy;
    vec2 v01 = imageLoad(coarse, clamp(b + ivec2(0, 1), ivec2(0), hi)).xy;
    vec2 v11 = imageLoad(coarse, clamp(b + ivec2(1, 1), ivec2(0), hi)).xy;
    vec2 value = mix(mix(v00, v10, f.x), mix(v01, v11, f.x), f.y);
    rawrTrace4(100u, q, 0u, vec4(value, float(p.flowScale), 0));
    imageStore(fine, q, vec4(value * float(p.flowScale), 0, 0));
}
