#version 450

#ifdef RAWR_PARITY_TRACE
layout(std430, set = 0, binding = 31) buffer RawrTraceBuffer {
    uint writeCount;
    uint droppedCount;
    uint _tracePad0;
    uint _tracePad1;
    uvec4 cfg0;
    ivec4 cfg1;
    uvec4 meta[];
}
rawrTrace;
const uint RAWR_TRACE_STAGE = 6u;
bool rawrTraceMatch(ivec2 q) {
    if (rawrTrace.cfg0.x == 0u) return false;
    if (rawrTrace.cfg0.y != 0u && rawrTrace.cfg0.y != RAWR_TRACE_STAGE) return false;
    int tx = int(rawrTrace.cfg0.z), ty = int(rawrTrace.cfg0.w);
    return (tx < 0 || q.x == tx) && (ty < 0 || q.y == ty);
}
void rawrTrace4(uint checkpoint, ivec2 q, uint aux, vec4 v) {
    if (!rawrTraceMatch(q)) return;
    uint i = atomicAdd(rawrTrace.writeCount, 1u);
    uint cap = uint(max(rawrTrace.cfg1.x, 0));
    if (i >= cap) {
        atomicAdd(rawrTrace.droppedCount, 1u);
        return;
    }
    uint b = i * 2u;
    rawrTrace.meta[b] = uvec4(RAWR_TRACE_STAGE, checkpoint, uint(q.x), uint(q.y));
    rawrTrace.meta[b + 1u] = uvec4(aux, floatBitsToUint(v.x), floatBitsToUint(v.y), floatBitsToUint(v.z));
}
#else
void rawrTrace4(uint checkpoint, ivec2 q, uint aux, vec4 v) {}
#endif

layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 0, r32f) readonly uniform image2D src;
layout(set = 0, binding = 1, r32f) writeonly uniform image2D dst;
layout(push_constant) uniform P {
    int axis;
    int radius;
    int factor;
    int outW;
    int outH;
    float sigma;
}
p;

// Frozen CPU oracle kernel() contract:
//   q = exp(...) in double
//   k[i] = float(q)
//   z += q in double
//   k[i] = float(double(k[i]) / z)
//
// Using exact float bit-patterns avoids the previous GPU path's float exp()
// plus per-pixel s/z normalization mismatch.
float cpuKernelWeight(int i) {
    int a = abs(i);
    if (p.factor == 2) {
        if (a == 0) return uintBitsToFloat(0x3ecc4252u);
        if (a == 1) return uintBitsToFloat(0x3e77c75du);
        if (a == 2) return uintBitsToFloat(0x3d5d25cdu);
        if (a == 3) return uintBitsToFloat(0x3b913926u);
        if (a == 4) return uintBitsToFloat(0x390c54e2u);
    } else if (p.factor == 4) {
        if (a == 0) return uintBitsToFloat(0x3e4c4315u);
        if (a == 1) return uintBitsToFloat(0x3e3442b8u);
        if (a == 2) return uintBitsToFloat(0x3df7c84au);
        if (a == 3) return uintBitsToFloat(0x3d84a0dbu);
        if (a == 4) return uintBitsToFloat(0x3cdd26a0u);
        if (a == 5) return uintBitsToFloat(0x3c0f9828u);
        if (a == 6) return uintBitsToFloat(0x3b1139b1u);
        if (a == 7) return uintBitsToFloat(0x39e4c5c6u);
        if (a == 8) return uintBitsToFloat(0x388c5569u);
    }
    return 0.0;
}

float cpuAccumulate(float sum, float weight, float value, bool finalTap) {
    // Frozen Apple/ARM Clang emits scalar FMA for the strided vertical loop.
    // The contiguous horizontal loop is vectorized as separate mul/add, with
    // only its final scalar remainder contracted.
    if (p.axis == 1 || finalTap) return fma(weight, value, sum);
    precise float product = weight * value;
    precise float next = sum + product;
    return next;
}

void main() {
    ivec2 q = ivec2(gl_GlobalInvocationID.xy);
    rawrTrace4(1u, q, 0u, vec4(gl_GlobalInvocationID.xy, 0, 0));
    if (q.x >= p.outW || q.y >= p.outH) return;

    precise float s = 0.0;
    if (p.factor == 2) {
        s = cpuAccumulate(s, cpuKernelWeight(-4),
                          imageLoad(src, q + (p.axis == 0 ? ivec2(-4 + p.radius, 0) : ivec2(0, -4 + p.radius))).x,
                          false);
        s = cpuAccumulate(s, cpuKernelWeight(-3),
                          imageLoad(src, q + (p.axis == 0 ? ivec2(-3 + p.radius, 0) : ivec2(0, -3 + p.radius))).x,
                          false);
        s = cpuAccumulate(s, cpuKernelWeight(-2),
                          imageLoad(src, q + (p.axis == 0 ? ivec2(-2 + p.radius, 0) : ivec2(0, -2 + p.radius))).x,
                          false);
        s = cpuAccumulate(s, cpuKernelWeight(-1),
                          imageLoad(src, q + (p.axis == 0 ? ivec2(-1 + p.radius, 0) : ivec2(0, -1 + p.radius))).x,
                          false);
        s = cpuAccumulate(s, cpuKernelWeight(0),
                          imageLoad(src, q + (p.axis == 0 ? ivec2(0 + p.radius, 0) : ivec2(0, 0 + p.radius))).x, false);
        s = cpuAccumulate(s, cpuKernelWeight(1),
                          imageLoad(src, q + (p.axis == 0 ? ivec2(1 + p.radius, 0) : ivec2(0, 1 + p.radius))).x, false);
        s = cpuAccumulate(s, cpuKernelWeight(2),
                          imageLoad(src, q + (p.axis == 0 ? ivec2(2 + p.radius, 0) : ivec2(0, 2 + p.radius))).x, false);
        s = cpuAccumulate(s, cpuKernelWeight(3),
                          imageLoad(src, q + (p.axis == 0 ? ivec2(3 + p.radius, 0) : ivec2(0, 3 + p.radius))).x, false);
        s = cpuAccumulate(s, cpuKernelWeight(4),
                          imageLoad(src, q + (p.axis == 0 ? ivec2(4 + p.radius, 0) : ivec2(0, 4 + p.radius))).x, true);
    } else if (p.factor == 4) {
        s = cpuAccumulate(s, cpuKernelWeight(-8),
                          imageLoad(src, q + (p.axis == 0 ? ivec2(-8 + p.radius, 0) : ivec2(0, -8 + p.radius))).x,
                          false);
        s = cpuAccumulate(s, cpuKernelWeight(-7),
                          imageLoad(src, q + (p.axis == 0 ? ivec2(-7 + p.radius, 0) : ivec2(0, -7 + p.radius))).x,
                          false);
        s = cpuAccumulate(s, cpuKernelWeight(-6),
                          imageLoad(src, q + (p.axis == 0 ? ivec2(-6 + p.radius, 0) : ivec2(0, -6 + p.radius))).x,
                          false);
        s = cpuAccumulate(s, cpuKernelWeight(-5),
                          imageLoad(src, q + (p.axis == 0 ? ivec2(-5 + p.radius, 0) : ivec2(0, -5 + p.radius))).x,
                          false);
        s = cpuAccumulate(s, cpuKernelWeight(-4),
                          imageLoad(src, q + (p.axis == 0 ? ivec2(-4 + p.radius, 0) : ivec2(0, -4 + p.radius))).x,
                          false);
        s = cpuAccumulate(s, cpuKernelWeight(-3),
                          imageLoad(src, q + (p.axis == 0 ? ivec2(-3 + p.radius, 0) : ivec2(0, -3 + p.radius))).x,
                          false);
        s = cpuAccumulate(s, cpuKernelWeight(-2),
                          imageLoad(src, q + (p.axis == 0 ? ivec2(-2 + p.radius, 0) : ivec2(0, -2 + p.radius))).x,
                          false);
        s = cpuAccumulate(s, cpuKernelWeight(-1),
                          imageLoad(src, q + (p.axis == 0 ? ivec2(-1 + p.radius, 0) : ivec2(0, -1 + p.radius))).x,
                          false);
        s = cpuAccumulate(s, cpuKernelWeight(0),
                          imageLoad(src, q + (p.axis == 0 ? ivec2(0 + p.radius, 0) : ivec2(0, 0 + p.radius))).x, false);
        s = cpuAccumulate(s, cpuKernelWeight(1),
                          imageLoad(src, q + (p.axis == 0 ? ivec2(1 + p.radius, 0) : ivec2(0, 1 + p.radius))).x, false);
        s = cpuAccumulate(s, cpuKernelWeight(2),
                          imageLoad(src, q + (p.axis == 0 ? ivec2(2 + p.radius, 0) : ivec2(0, 2 + p.radius))).x, false);
        s = cpuAccumulate(s, cpuKernelWeight(3),
                          imageLoad(src, q + (p.axis == 0 ? ivec2(3 + p.radius, 0) : ivec2(0, 3 + p.radius))).x, false);
        s = cpuAccumulate(s, cpuKernelWeight(4),
                          imageLoad(src, q + (p.axis == 0 ? ivec2(4 + p.radius, 0) : ivec2(0, 4 + p.radius))).x, false);
        s = cpuAccumulate(s, cpuKernelWeight(5),
                          imageLoad(src, q + (p.axis == 0 ? ivec2(5 + p.radius, 0) : ivec2(0, 5 + p.radius))).x, false);
        s = cpuAccumulate(s, cpuKernelWeight(6),
                          imageLoad(src, q + (p.axis == 0 ? ivec2(6 + p.radius, 0) : ivec2(0, 6 + p.radius))).x, false);
        s = cpuAccumulate(s, cpuKernelWeight(7),
                          imageLoad(src, q + (p.axis == 0 ? ivec2(7 + p.radius, 0) : ivec2(0, 7 + p.radius))).x, false);
        s = cpuAccumulate(s, cpuKernelWeight(8),
                          imageLoad(src, q + (p.axis == 0 ? ivec2(8 + p.radius, 0) : ivec2(0, 8 + p.radius))).x, true);
    }
    rawrTrace4(100u, q, 0u, vec4(s, 0.0, s, 0.0));
    imageStore(dst, q, vec4(s));
}
