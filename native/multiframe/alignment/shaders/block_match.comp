#version 450

// Candidate-parallel block matching with shared-memory caching.
// Candidate search, accumulation order, tie-breaking, LK refine selection,
// and boundary handling follow the reference contract. Ref/mov texels come
// from a single cooperative preload into shared memory per workgroup instead
// of repeated global imageLoad.
#ifdef RAWR_PARITY_TRACE
layout(std430, set = 0, binding = 31) buffer RawrTraceBuffer {
    uint writeCount;
    uint droppedCount;
    uint _tracePad0;
    uint _tracePad1;
    uvec4 cfg0;
    ivec4 cfg1;
    uvec4 meta[];
}
rawrTrace;
const uint RAWR_TRACE_STAGE = 1u;
bool rawrTraceMatch(ivec2 q) {
    if (rawrTrace.cfg0.x == 0u) return false;
    if (rawrTrace.cfg0.y != 0u && rawrTrace.cfg0.y != RAWR_TRACE_STAGE) return false;
    int tx = int(rawrTrace.cfg0.z), ty = int(rawrTrace.cfg0.w);
    return (tx < 0 || q.x == tx) && (ty < 0 || q.y == ty);
}
void rawrTrace4(uint checkpoint, ivec2 q, uint aux, vec4 v) {
    if (!rawrTraceMatch(q)) return;
    uint i = atomicAdd(rawrTrace.writeCount, 1u);
    uint cap = uint(max(rawrTrace.cfg1.x, 0));
    if (i >= cap) {
        atomicAdd(rawrTrace.droppedCount, 1u);
        return;
    }
    uint b = i * 2u;
    rawrTrace.meta[b] = uvec4(RAWR_TRACE_STAGE, checkpoint, uint(q.x), uint(q.y));
    rawrTrace.meta[b + 1u] = uvec4(aux, floatBitsToUint(v.x), floatBitsToUint(v.y), floatBitsToUint(v.z));
}
#else
void rawrTrace4(uint checkpoint, ivec2 q, uint aux, vec4 v) {}
#endif
void rawrTrace1(uint checkpoint, ivec2 q, uint aux, float x) { rawrTrace4(checkpoint, q, aux, vec4(x, 0, 0, 0)); }

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, r32f) readonly uniform image2D refI;
layout(set = 0, binding = 1, r32f) readonly uniform image2D movI;
layout(set = 0, binding = 2, rg32f) uniform image2D flow;
// V2: production costs write removed (never consumed). best/second still
// computed for winner selection + trace parity; only the global store is gone.
layout(push_constant) uniform P {
    int tileSize;
    int radius;
    int metric;
    int tilesX;
    int tilesY;
}
p;

shared float candidateCost[81];
shared int refineIndex[16];
shared float refineHigh[64];
shared float refineLow[64];
// Max: ts=16 -> ref 256; winSz=16+2*4=24 -> mov 576. Total 832 floats ~3.3KB.
shared float sRef[256];
shared float sMov[576];

float sampleMov(ivec2 q) {
    ivec2 n = imageSize(movI);
    if (p.metric == 1)
        q = clamp(q, ivec2(0), n - 1);
    else if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, n)))
        return 0;
    return imageLoad(movI, q).x;
}

void addFloatFloat(inout float sumHi, inout float sumLo, float termHi, float termLo) {
    precise float s = sumHi + termHi;
    precise float bb = s - sumHi;
    precise float err = (sumHi - (s - bb)) + (termHi - bb);
    precise float tlo = sumLo + err + termLo;
    precise float z = s + tlo;
    sumLo = tlo - (z - s);
    sumHi = z;
}

void main() {
    ivec2 t = ivec2(gl_WorkGroupID.xy);
    if (t.x >= p.tilesX || t.y >= p.tilesY) return;

    uint lane = gl_LocalInvocationIndex;
    vec2 f = imageLoad(flow, t).xy;
    vec2 rounded = roundEven(f);
    if (p.metric == 0) {
        // Same frozen half-integer tie bias as V1.
        vec2 distance = abs(f - rounded);
        if (distance.x == 0.5) rounded.x = sign(f.x) * floor(abs(f.x) + 0.5);
        if (distance.y == 0.5) rounded.y = sign(f.y) * floor(abs(f.y) + 0.5);
    }
    ivec2 base = ivec2(rounded);
    int side = 2 * p.radius + 1;
    int count = side * side;

    if (lane == 0u) rawrTrace4(1u, t, 0u, vec4(f, float(p.radius), 0.0));

    // --- Shared-memory preload (V2 only, bit-identical values) ---
    // Ref tile at tileOrg (always in-bounds: dispatched tiles are complete).
    // Mov window at tileOrg+base-radius, size (ts+2r)^2, with sampleMov
    // clamp/zero semantics baked in so the hot loop is branch-free.
    int ts = p.tileSize;
    int rad = p.radius;
    int winSz = ts + 2 * rad;
    int refCount = ts * ts;
    int movCount = winSz * winSz;
    int totalLoads = refCount + movCount;
    ivec2 tileOrg = t * ts;
    ivec2 movSize = imageSize(movI);
    ivec2 winOrg = tileOrg + base - ivec2(rad);
    for (int idx = int(lane); idx < totalLoads; idx += 64) {
        if (idx < refCount) {
            int ry = idx / ts;
            int rx = idx - ry * ts;
            ivec2 q = tileOrg + ivec2(rx, ry);
            sRef[idx] = imageLoad(refI, q).x;
        } else {
            int mi = idx - refCount;
            int my = mi / winSz;
            int mx = mi - my * winSz;
            ivec2 q = winOrg + ivec2(mx, my);
            float v;
            if (p.metric == 1) {
                q = clamp(q, ivec2(0), movSize - 1);
                v = imageLoad(movI, q).x;
            } else {
                if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, movSize)))
                    v = 0.0;
                else
                    v = imageLoad(movI, q).x;
            }
            sMov[mi] = v;
        }
    }
    barrier();

    // Radius <= 4 in Multiframe, so at most 81 candidates. 64 lanes process
    // them in two waves. Each candidate retains the original xx/yy scalar
    // summation order, avoiding a parallel reduction that would perturb cost.
    //
    // V2 specialization: tileSize/metric are uniform per dispatch, so hoist
    // them into literal-bound loop nests (unrollable, no per-pixel ternary)
    // with row-stepped mov indexing (one dynamic mul per row, not per pixel).
    // Operation order and values are unchanged => bit-identical.
    for (int ci = int(lane); ci < count; ci += 64) {
        int sy = ci / side - p.radius;
        int sx = ci % side - p.radius;
        ivec2 d = base + ivec2(sx, sy);
        // d is retained for trace parity; hot path uses shared indices.
        precise float sumHi = 0.0, sumCorrection = 0.0;
        int mRowBase = (sy + rad) * winSz + (sx + rad);
        if (ts == 16) {
            if (p.metric == 0) {
                for (int yy = 0; yy < 16; yy++) {
                    int r = yy * 16;
                    int m = mRowBase + yy * winSz;
                    for (int xx = 0; xx < 16; xx++) {
                        float refV = sRef[r + xx];
                        float movV = sMov[m + xx];
                        precise float e = refV - movV;
                        precise float term = abs(e);
                        precise float corrected = term - sumCorrection;
                        precise float next = sumHi + corrected;
                        sumCorrection = (next - sumHi) - corrected;
                        sumHi = next;
                        rawrTrace4(110u, t, uint((sy + p.radius) * 64 + (sx + p.radius)), vec4(e, term, sumHi, 0));
                    }
                }
            } else {
                for (int yy = 0; yy < 16; yy++) {
                    int r = yy * 16;
                    int m = mRowBase + yy * winSz;
                    for (int xx = 0; xx < 16; xx++) {
                        float refV = sRef[r + xx];
                        float movV = sMov[m + xx];
                        precise float e = refV - movV;
                        precise float term = e * e;
                        precise float corrected = term - sumCorrection;
                        precise float next = sumHi + corrected;
                        sumCorrection = (next - sumHi) - corrected;
                        sumHi = next;
                        rawrTrace4(110u, t, uint((sy + p.radius) * 64 + (sx + p.radius)), vec4(e, term, sumHi, 0));
                    }
                }
            }
        } else {
            if (p.metric == 0) {
                for (int yy = 0; yy < 8; yy++) {
                    int r = yy * 8;
                    int m = mRowBase + yy * winSz;
                    for (int xx = 0; xx < 8; xx++) {
                        float refV = sRef[r + xx];
                        float movV = sMov[m + xx];
                        precise float e = refV - movV;
                        precise float term = abs(e);
                        precise float corrected = term - sumCorrection;
                        precise float next = sumHi + corrected;
                        sumCorrection = (next - sumHi) - corrected;
                        sumHi = next;
                        rawrTrace4(110u, t, uint((sy + p.radius) * 64 + (sx + p.radius)), vec4(e, term, sumHi, 0));
                    }
                }
            } else {
                for (int yy = 0; yy < 8; yy++) {
                    int r = yy * 8;
                    int m = mRowBase + yy * winSz;
                    for (int xx = 0; xx < 8; xx++) {
                        float refV = sRef[r + xx];
                        float movV = sMov[m + xx];
                        precise float e = refV - movV;
                        precise float term = e * e;
                        precise float corrected = term - sumCorrection;
                        precise float next = sumHi + corrected;
                        sumCorrection = (next - sumHi) - corrected;
                        sumHi = next;
                        rawrTrace4(110u, t, uint((sy + p.radius) * 64 + (sx + p.radius)), vec4(e, term, sumHi, 0));
                    }
                }
            }
        }
        precise float c = sumHi;
        candidateCost[ci] = c;
        rawrTrace4(120u, t, uint((sy + p.radius) * 64 + (sx + p.radius)), vec4(vec2(d), c, 0.0));
    }
    barrier();

    // Native accumulation is enough to separate almost every candidate, but
    // a handful of tiles have near ties. Re-evaluate the eight cheapest
    // candidates with the frozen two-float sum so their final ordering remains
    // stable without paying that cost for all 81 candidates.
    bool coarseBorder = p.tilesX < 200 && (t.x < 2 || t.y < 2 || t.x + 2 >= p.tilesX || t.y + 2 >= p.tilesY);
    int refineCount = coarseBorder ? 16 : 0;
    if (lane == 0u) {
        float topCost[16];
        for (int k = 0; k < 16; ++k) {
            topCost[k] = 3.402823e38;
            refineIndex[k] = -1;
        }
        for (int ci = 0; ci < count; ++ci) {
            float c = candidateCost[ci];
            for (int k = 0; k < refineCount; ++k) {
                if (c < topCost[k]) {
                    for (int j = refineCount - 1; j > k; --j) {
                        topCost[j] = topCost[j - 1];
                        refineIndex[j] = refineIndex[j - 1];
                    }
                    topCost[k] = c;
                    refineIndex[k] = ci;
                    break;
                }
            }
        }
    }
    barrier();
    if (lane < 64u) {
        uint groupSize = refineCount == 16 ? 4u : 8u;
        uint candidateLane = lane / groupSize;
        uint pixelLane = lane - candidateLane * groupSize;
        int ci = candidateLane < uint(refineCount) ? refineIndex[candidateLane] : -1;
        precise float sumHi = 0.0, sumLo = 0.0;
        if (ci >= 0) {
            int sy = ci / side - p.radius;
            int sx = ci % side - p.radius;
            int pixelCount = p.tileSize * p.tileSize;
            for (int pi = int(pixelLane); pi < pixelCount; pi += int(groupSize)) {
                int yy = pi / ts, xx = pi - yy * ts;
                float refV = sRef[pi];
                int mx = xx + sx + rad;
                int my = yy + sy + rad;
                float movV = sMov[my * winSz + mx];
                precise float e = refV - movV;
                precise float termHi, termLo;
                if (p.metric == 0) {
                    termHi = abs(e);
                    termLo = 0.0;
                } else {
                    termHi = e * e;
                    termLo = fma(e, e, -termHi);
                }
                addFloatFloat(sumHi, sumLo, termHi, termLo);
            }
        }
        refineHigh[lane] = sumHi;
        refineLow[lane] = sumLo;
    }
    barrier();
    if (lane < uint(refineCount)) {
        int ci = refineIndex[lane];
        if (ci >= 0) {
            precise float sumHi = 0.0, sumLo = 0.0;
            uint groupSize = refineCount == 16 ? 4u : 8u;
            uint baseLane = lane * groupSize;
            for (uint k = 0u; k < groupSize; ++k)
                addFloatFloat(sumHi, sumLo, refineHigh[baseLane + k], refineLow[baseLane + k]);
            candidateCost[ci] = sumHi + sumLo;
        }
    }
    barrier();

    if (lane == 0u) {
        float best = 3.402823e38, second = best;
        ivec2 win = base;
        // Preserve the original nested sy/sx candidate ordering and strict '<'.
        for (int ci = 0; ci < count; ++ci) {
            int sy = ci / side - p.radius;
            int sx = ci % side - p.radius;
            ivec2 d = base + ivec2(sx, sy);
            float c = candidateCost[ci];
            if (c < best) {
                second = best;
                best = c;
                win = d;
                rawrTrace4(121u, t, 0u, vec4(vec2(win), best, 0.0));
            } else if (c < second) {
                second = c;
                rawrTrace1(122u, t, 0u, second);
            }
        }
        imageStore(flow, t, vec4(vec2(win), 0, 0));
        rawrTrace4(200u, t, 0u, vec4(vec2(win), best, 0.0));
        rawrTrace1(201u, t, 0u, second);
    }
}
