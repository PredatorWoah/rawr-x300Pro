#version 450

// Tile-parallel ReferenceParity LK/ICA.
// One workgroup owns one flow tile. Each lane processes strided pixels while
// reductions are performed in deterministic lane order. This intentionally
// changes FP summation order vs the scalar oracle, so the frozen checkpoint
// batch remains the acceptance gate; no algorithmic geometry/iterations change.
#ifdef RAWR_PARITY_TRACE
layout(std430, set = 0, binding = 31) buffer RawrTraceBuffer {
    uint writeCount;
    uint droppedCount;
    uint _tracePad0;
    uint _tracePad1;
    uvec4 cfg0;
    ivec4 cfg1;
    uvec4 meta[];
}
rawrTrace;
const uint RAWR_TRACE_STAGE = 4u;
bool rawrTraceMatch(ivec2 q) {
    if (rawrTrace.cfg0.x == 0u) return false;
    if (rawrTrace.cfg0.y != 0u && rawrTrace.cfg0.y != RAWR_TRACE_STAGE) return false;
    int tx = int(rawrTrace.cfg0.z), ty = int(rawrTrace.cfg0.w);
    return (tx < 0 || q.x == tx) && (ty < 0 || q.y == ty);
}
void rawrTrace4(uint checkpoint, ivec2 q, uint aux, vec4 v) {
    if (!rawrTraceMatch(q)) return;
    uint i = atomicAdd(rawrTrace.writeCount, 1u);
    uint cap = uint(max(rawrTrace.cfg1.x, 0));
    if (i >= cap) {
        atomicAdd(rawrTrace.droppedCount, 1u);
        return;
    }
    uint b = i * 2u;
    rawrTrace.meta[b] = uvec4(RAWR_TRACE_STAGE, checkpoint, uint(q.x), uint(q.y));
    rawrTrace.meta[b + 1u] = uvec4(aux, floatBitsToUint(v.x), floatBitsToUint(v.y), floatBitsToUint(v.z));
}
#else
void rawrTrace4(uint checkpoint, ivec2 q, uint aux, vec4 v) {}
#endif
void rawrTrace1(uint checkpoint, ivec2 q, uint aux, float x) { rawrTrace4(checkpoint, q, aux, vec4(x, 0, 0, 0)); }

// V2-only fork of lk_refine.comp: production diag write removed.
// h00/h01/hdet/srms computation and trace ABI are unchanged; only the
// global imageStore(diag) is dropped (never consumed downstream).
// V1 (lk_refine.comp) is untouched.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, r32f) readonly uniform image2D refI;
layout(set = 0, binding = 1, r32f) readonly uniform image2D movI;
layout(set = 0, binding = 2, rg32f) uniform image2D flow;
// Per-tile reference structure tensor for the aperture-aware affine gate.
// Bound at every level; coarse levels only touch a prefix of the fine-tile
// grid and the fine level (dispatched last) overwrites every tile.
layout(set = 0, binding = 3, rgba32f) writeonly uniform image2D tensorOut;
layout(push_constant) uniform P {
    int ts;
    int tilesX;
    int tilesY;
    int iterations;
    float eps;
    float clipRadius;
    // Mean CFA noise model (variance = slope * x + offset, normalized units)
    // for the tensor's expected noise-gradient energy.
    float noiseSlope;
    float noiseOffset;
}
p;

float z(ivec2 q) {
    return any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, imageSize(refI))) ? 0 : imageLoad(refI, q).x;
}
float mz(ivec2 q) {
    return any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, imageSize(movI))) ? 0 : imageLoad(movI, q).x;
}
// Match the frozen Apple/ARM CPU contraction contract explicitly. These are
// standard GLSL FMAs, so the arithmetic does not depend on a driver's implicit
// contraction choices (MoltenVK, Adreno, or otherwise).
float interpH(float a, float b, float f) { return fma(b - a, f, a); }
float interpV(float a, float b, float f) { return fma(b - a, f, a); }
float bil(ivec2 q, vec2 d) {
    vec2 ip = floor(d), fr = d - ip;
    ivec2 b = q + ivec2(ip);
    float a = mz(b), b1 = mz(b + ivec2(1, 0)), c = mz(b + ivec2(0, 1)), dd = mz(b + ivec2(1));
    float x0 = interpH(a, b1, fr.x), x1 = interpH(c, dd, fr.x);
    return interpV(x0, x1, fr.y);
}

float cpuReciprocal(float denominator) {
    // A single FMA-residual Newton correction removes the low-precision fast
    // reciprocal error while preserving a correctly rounded initial result.
    float approximate = 1.0 / denominator;
    float remainder = fma(-approximate, denominator, 1.0);
    return fma(remainder, approximate, approximate);
}

shared float sgx[256];
shared float sgy[256];
shared float sdt[256];
shared vec2 sf;
shared float sid, srms;
shared float h00, h01, h11, hdet;
shared float reduce0[64];
shared float reduce1[64];
shared float reduce2[64];

void reduceThree(float a, float b, float c, out float ra, out float rb, out float rc) {
    uint lane = gl_LocalInvocationIndex;
    reduce0[lane] = a;
    reduce1[lane] = b;
    reduce2[lane] = c;
    barrier();
    for (uint stride = 32u; stride > 0u; stride >>= 1u) {
        if (lane < stride) {
            reduce0[lane] += reduce0[lane + stride];
            reduce1[lane] += reduce1[lane + stride];
            reduce2[lane] += reduce2[lane + stride];
        }
        barrier();
    }
    ra = reduce0[0];
    rb = reduce1[0];
    rc = reduce2[0];
}

void main() {
    ivec2 t = ivec2(gl_WorkGroupID.xy);
    if (t.x >= p.tilesX || t.y >= p.tilesY) return;
    uint lane = gl_LocalInvocationIndex;
    int count = p.ts * p.ts;

    for (int pi = int(lane); pi < count; pi += 64) {
        int yy = pi / p.ts, xx = pi - yy * p.ts;
        ivec2 q = t * p.ts + ivec2(xx, yy);
        sgx[pi] = z(q + ivec2(1, 0)) - z(q - ivec2(1, 0));
        sgy[pi] = z(q + ivec2(0, 1)) - z(q - ivec2(0, 1));
    }
    barrier();

    float localA00 = 0.0, localA01 = 0.0, localA11 = 0.0;
    for (int pi = int(lane); pi < count; pi += 64) {
        float gx = sgx[pi], gy = sgy[pi];
        localA00 = fma(gx, gx, localA00);
        localA01 = fma(gx, gy, localA01);
        localA11 = fma(gy, gy, localA11);
    }
    float A00, A01, A11;
    reduceThree(localA00, localA01, localA11, A00, A01, A11);
    float localSum = 0.0;
    for (int pi = int(lane); pi < count; pi += 64) {
        int yy = pi / p.ts, xx = pi - yy * p.ts;
        localSum += z(t * p.ts + ivec2(xx, yy));
    }
    float tileSum, unused0, unused1;
    reduceThree(localSum, 0.0, 0.0, tileSum, unused0, unused1);
    if (lane == 0u) {
        float a01sq = A01 * A01;
        float det = fma(A00, A11, -a01sq);
        h00 = A00;
        h01 = A01;
        h11 = A11;
        hdet = det;
        sf = imageLoad(flow, t).xy;
        sid = (abs(det) >= p.eps) ? cpuReciprocal(det) : 0.0;
        srms = 0.0;
        rawrTrace4(100u, t, 0u, vec4(A00, A01, A11, 0));
        rawrTrace1(101u, t, 0u, det);
    }
    barrier();

    if (abs(hdet) >= p.eps) {
        for (int it = 0; it < p.iterations; it++) {
            vec2 f = sf;
            for (int pi = int(lane); pi < count; pi += 64) {
                int yy = pi / p.ts, xx = pi - yy * p.ts;
                ivec2 q = t * p.ts + ivec2(xx, yy);
                sdt[pi] = bil(q, f) - z(q);
            }
            barrier();
            float localB0 = 0.0, localB1 = 0.0, localRSS = 0.0;
            for (int pi = int(lane); pi < count; pi += 64) {
                float gx = sgx[pi], gy = sgy[pi], dt = sdt[pi];
                localB0 = fma(-gx, dt, localB0);
                localB1 = fma(-gy, dt, localB1);
                localRSS = fma(dt, dt, localRSS);
                rawrTrace4(120u, t, uint(it * 65536 + pi), vec4(gx, gy, dt, 0));
            }
            float B0, B1, RSS;
            reduceThree(localB0, localB1, localRSS, B0, B1, RSS);
            if (lane == 0u) {
                float nx = fma(h11, B0, -h01 * B1);
                float ny = fma(-h01, B0, h00 * B1);
                vec2 delta = vec2(sid * nx, sid * ny);
                delta = clamp(delta, vec2(-p.clipRadius), vec2(p.clipRadius));
                rawrTrace4(130u, t, uint(it), vec4(B0, B1, RSS, 0));
                rawrTrace4(131u, t, uint(it), vec4(sf, delta.x, 0));
                rawrTrace1(132u, t, uint(it), delta.y);
                sf += delta;
                srms = sqrt(RSS / float(count));
            }
            barrier();
        }
    }
    if (lane == 0u) {
        imageStore(flow, t, vec4(sf, 0, 0));
        if (all(lessThan(t, imageSize(tensorOut)))) {
            // Expected per-axis gradient energy of pure noise: central difference
            // of the [1 4 6 4 1]^2/256-blurred alignment view has variance
            // 1.2 * (70/256)^2 * sigma^2 per pixel.
            float meanLevel = max(tileSum / float(count), 0.0);
            float sigma2 = max(fma(p.noiseSlope, meanLevel, p.noiseOffset), 0.0);
            float noiseEnergy = float(count) * 1.2 * (70.0 / 256.0) * (70.0 / 256.0) * sigma2;
            imageStore(tensorOut, t, vec4(h00, h01, h11, noiseEnergy));
        }
        rawrTrace4(200u, t, 0u, vec4(sf, srms, 0));
    }
}
