#version 450
#ifdef RAWR_PARITY_TRACE
layout(std430, set = 0, binding = 31) buffer RawrTraceBuffer {
    uint writeCount;
    uint droppedCount;
    uint _tracePad0;
    uint _tracePad1;
    uvec4 cfg0;
    ivec4 cfg1;
    uvec4 meta[];
}
rawrTrace;
const uint RAWR_TRACE_STAGE = 20u;
bool rawrTraceMatch(ivec2 q) {
    if (rawrTrace.cfg0.x == 0u) return false;
    if (rawrTrace.cfg0.y != 0u && rawrTrace.cfg0.y != RAWR_TRACE_STAGE) return false;
    int tx = int(rawrTrace.cfg0.z), ty = int(rawrTrace.cfg0.w);
    return (tx < 0 || q.x == tx) && (ty < 0 || q.y == ty);
}
void rawrTrace4(uint checkpoint, ivec2 q, uint aux, vec4 v) {
    if (!rawrTraceMatch(q)) return;
    uint i = atomicAdd(rawrTrace.writeCount, 1u);
    uint cap = uint(max(rawrTrace.cfg1.x, 0));
    if (i >= cap) {
        atomicAdd(rawrTrace.droppedCount, 1u);
        return;
    }
    uint b = i * 2u;
    rawrTrace.meta[b] = uvec4(RAWR_TRACE_STAGE, checkpoint, uint(q.x), uint(q.y));
    rawrTrace.meta[b + 1u] = uvec4(aux, floatBitsToUint(v.x), floatBitsToUint(v.y), floatBitsToUint(v.z));
}
#else
void rawrTrace4(uint checkpoint, ivec2 q, uint aux, vec4 v) {}
#endif
layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 0, r16ui) readonly uniform uimage2D rawU16;
layout(set = 0, binding = 1, r32f) writeonly uniform image2D rawF32;
layout(push_constant) uniform P {
    vec4 blackByPhase;
    float whiteLevel;
    int width;
    int height;
}
p;
void main() {
    ivec2 q = ivec2(gl_GlobalInvocationID.xy);
    if (q.x >= p.width || q.y >= p.height) return;
    int phase = (q.y & 1) * 2 + (q.x & 1);
    precise float raw = float(imageLoad(rawU16, q).x);
    precise float b = p.blackByPhase[phase];
    precise float den = max(1.0, p.whiteLevel - b);
    precise float numerator = raw - b;
    // Correct the device division with the exact FMA residual. This preserves
    // global fast math while recovering the CPU's correctly rounded quotient.
    precise float quotientApproximate = numerator / den;
    precise float remainder = fma(-quotientApproximate, den, numerator);
    precise float reciprocal = 1.0 / den;
    precise float quotient = fma(remainder, reciprocal, quotientApproximate);
    // No clamp at black: read noise around black is zero-mean, and clipping
    // each frame before averaging biases deep shadows upward (sigma/sqrt(2pi)
    // per channel, a colour cast after WB). Consumers that need non-negative
    // input (GAT, sqrt guide, output encoders) clamp locally. No high clamp.
    precise float v = quotient;
    rawrTrace4(100u, q, uint(phase), vec4(raw, b, den, v));
    imageStore(rawF32, q, vec4(v));
}
