#version 450

// Conceals the sensor's reported hot/defective pixels in a normalized RAW
// frame, before alignment and merge see it. One invocation per listed pixel:
// the value becomes the median of its four same-CFA-phase neighbours at
// distance 2 (same rule as the single-frame HotPixelConceal path), so a
// stuck pixel never enters the merge as a bright dot.
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, r32f) uniform image2D rawF32;
layout(std430, set = 0, binding = 1) readonly buffer HotPixels { ivec2 xy[]; } hot;
layout(push_constant) uniform P {
    int count;
    int width;
    int height;
} p;

void main() {
    int i = int(gl_GlobalInvocationID.x);
    if (i >= p.count) return;
    ivec2 q = hot.xy[i];
    if (any(lessThan(q, ivec2(0))) || q.x >= p.width || q.y >= p.height) return;
    float v[4];
    int n = 0;
    if (q.x - 2 >= 0) v[n++] = imageLoad(rawF32, q + ivec2(-2, 0)).x;
    if (q.x + 2 < p.width) v[n++] = imageLoad(rawF32, q + ivec2(2, 0)).x;
    if (q.y - 2 >= 0) v[n++] = imageLoad(rawF32, q + ivec2(0, -2)).x;
    if (q.y + 2 < p.height) v[n++] = imageLoad(rawF32, q + ivec2(0, 2)).x;
    if (n == 0) return;
    // Sort the (at most four) neighbours.
    for (int a = 1; a < n; ++a) {
        float key = v[a];
        int b = a - 1;
        while (b >= 0 && v[b] > key) {
            v[b + 1] = v[b];
            --b;
        }
        v[b + 1] = key;
    }
    float median = (n % 2 == 1) ? v[n / 2] : 0.5 * (v[n / 2 - 1] + v[n / 2]);
    imageStore(rawF32, q, vec4(median));
}
