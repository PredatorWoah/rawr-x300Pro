// galosh_bridge_norm.comp — app-authored (not upstream).
// R16_UINT Bayer storage image -> float32 [0,1] buffer via a host-built
// 65536-entry LUT (exact float32 (code-black)/range per entry).
//
// WHY A LUT: Apple Silicon has no correctly-rounded float division (it
// reduces to reciprocal-based evaluation, ~1 ulp off CPU at ~46% of
// pixels). That 1-ulp input noise cascades through BayesShrink keep/kill
// decisions to ~66 dB end-to-end instead of the >= 69 dB the same graph
// reaches with exact inputs. The LUT is built host-side with plain float
// ops (bit-identical to the numpy oracle conversion), uploaded once per
// (black, white) epoch; the shader does a single exact lookup. Faster
// than dividing, too.
#version 450
layout(local_size_x = 16, local_size_y = 16) in;

layout(r16ui, binding = 0) readonly uniform uimage2D bayerIn;
layout(std430, binding = 1) buffer LutBuf { float v[]; } lutBuf;
layout(std430, binding = 2) buffer OutBuf { float v[]; } outBuf;

layout(push_constant) uniform Push {
    int width;
    int height;
} pc;

void main() {
    const int x = int(gl_GlobalInvocationID.x);
    const int y = int(gl_GlobalInvocationID.y);
    if (x >= pc.width || y >= pc.height) return;
    const uint code = imageLoad(bayerIn, ivec2(x, y)).x;
    outBuf.v[y * pc.width + x] = lutBuf.v[code];
}
