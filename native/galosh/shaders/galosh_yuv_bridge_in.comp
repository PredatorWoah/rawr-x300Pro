// galosh_yuv_bridge_in.comp — app-authored (not upstream).
// Linear RGBA16F image -> Y (f32) + Cb/Cr (f16 RNE) buffers, BT.709,
// centred chroma, NO gamma (linear entry; cf. darktable port note in
// galosh_yuv_cpu.c:855). Pure multiply-add: no Metal division hazard.
#version 450
layout(local_size_x = 16, local_size_y = 16) in;

#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(rgba16f, binding = 0) readonly uniform image2D rgbIn;
layout(std430, binding = 1) buffer B1 { float yOut[]; };
layout(std430, binding = 2) buffer B2 { float16_t cbOut[]; };
layout(std430, binding = 3) buffer B3 { float16_t crOut[]; };

layout(push_constant) uniform PC { int width; int height; } pc;

const float BT709_KR = 0.2126f, BT709_KG = 0.7152f, BT709_KB = 0.0722f;
const float BT709_CB_DEN = 1.8556f, BT709_CR_DEN = 1.5748f;

void main() {
    const int x = int(gl_GlobalInvocationID.x);
    const int y = int(gl_GlobalInvocationID.y);
    if (x >= pc.width || y >= pc.height) return;
    const vec4 px = imageLoad(rgbIn, ivec2(x, y));
    const float Y = BT709_KR * px.x + BT709_KG * px.y + BT709_KB * px.z;
    const float Cb = (px.z - Y) * (1.0f / BT709_CB_DEN);
    const float Cr = (px.x - Y) * (1.0f / BT709_CR_DEN);
    const int i = y * pc.width + x;
    yOut[i] = Y;
    cbOut[i] = float16_t(Cb);
    crOut[i] = float16_t(Cr);
}
