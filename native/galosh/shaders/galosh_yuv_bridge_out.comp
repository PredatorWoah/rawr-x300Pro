// galosh_yuv_bridge_out.comp — app-authored (not upstream).
// Denoised Y (f32) + Cb/Cr (f16, exact widen) -> linear RGBA16F image,
// BT.709 inverse. NO [0,1] clip and NO gamma: the tap sits pre-tonemap in
// scene-linear HDR (clipping here would destroy headroom the tonemap
// needs; upstream clips only because sRGB output demands [0,1]).
// Replaces yuv_ycc2srgb (gamma+clip) for the linear entry; math mirrors
// its BT.709 inverse exactly.
//
// HDR KNEE: the inverse-GAT LUT covers x in [0,1]; highlights above it
// cannot be inverted faithfully, and need it least (photon SNR is highest
// there). Pixels with noisy luma above kneeLo pass the INPUT through via
// a smoothstep ramp to kneeHi (exact preservation, no cliff). Defaults
// 1.0 -> 1.5; photon noise in the ramp is tamed downstream by tonemap
// compression, and film grain sits on top anyway.
//
// The noisy guide + noisy chroma arrive as BUFFERS (yNoisy snap + the
// untouched cb/cr input planes), never as a second image read: buffer
// WORM semantics make in-place src==dst use safe by construction.
#version 450
layout(local_size_x = 16, local_size_y = 16) in;

#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(std430, binding = 0) restrict readonly buffer B0 { float yIn[]; };
layout(std430, binding = 1) restrict readonly buffer B1 { float16_t cbIn[]; };
layout(std430, binding = 2) restrict readonly buffer B2 { float16_t crIn[]; };
layout(rgba16f, binding = 3) writeonly uniform image2D rgbOut;
layout(std430, binding = 4) restrict readonly buffer B4 { float yNoisy[]; };
layout(std430, binding = 5) restrict readonly buffer B5 { float16_t cbNoisy[]; };
layout(std430, binding = 6) restrict readonly buffer B6 { float16_t crNoisy[]; };

layout(push_constant) uniform PC {
    int width;
    int height;
    float kneeLo;
    float kneeHi;
} pc;

const float BT709_KR = 0.2126f, BT709_KG = 0.7152f, BT709_KB = 0.0722f;
const float BT709_CB_DEN = 1.8556f, BT709_CR_DEN = 1.5748f;

vec3 ycc_to_rgb(float Y, float Cb, float Cr) {
    const float R = Y + BT709_CR_DEN * Cr;
    const float G = Y - (BT709_KR * BT709_CR_DEN / BT709_KG) * Cr
                      - (BT709_KB * BT709_CB_DEN / BT709_KG) * Cb;
    const float B = Y + BT709_CB_DEN * Cb;
    return vec3(R, G, B);
}

void main() {
    const int x = int(gl_GlobalInvocationID.x);
    const int y = int(gl_GlobalInvocationID.y);
    if (x >= pc.width || y >= pc.height) return;
    const int i = y * pc.width + x;
    const vec3 core = ycc_to_rgb(yIn[i], float(cbIn[i]), float(crIn[i]));
    const vec3 noisy = ycc_to_rgb(yNoisy[i], float(cbNoisy[i]), float(crNoisy[i]));
    const float t = smoothstep(pc.kneeLo, pc.kneeHi, yNoisy[i]);
    imageStore(rgbOut, ivec2(x, y), vec4(mix(core, noisy, t), 1.0f));
}
