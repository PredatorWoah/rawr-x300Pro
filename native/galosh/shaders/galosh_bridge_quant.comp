// galosh_bridge_quant.comp — app-authored (not upstream).
// Float32 [0,1] buffer -> R16_UINT Bayer storage image (inverse of
// galosh_bridge_norm.comp). Exact-roundtrip for noisy data: quant step
// (white-black)/65535 sits far below the sensor noise floor.
#version 450
layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, binding = 0) buffer InBuf { float v[]; } inBuf;
layout(r16ui, binding = 1) writeonly uniform uimage2D bayerOut;

layout(push_constant) uniform Push {
    int width;
    int height;
    float black;
    float white;
} pc;

void main() {
    const int x = int(gl_GlobalInvocationID.x);
    const int y = int(gl_GlobalInvocationID.y);
    if (x >= pc.width || y >= pc.height) return;
    const float range = max(pc.white - pc.black, 1e-6);
    const float code = clamp(round(inBuf.v[y * pc.width + x] * range + pc.black), 0.0, 65535.0);
    imageStore(bayerOut, ivec2(x, y), uvec4(uint(code), 0u, 0u, 0u));
}
